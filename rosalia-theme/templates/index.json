    "faq_home": {
      "type": "rosalia-faq",
      "settings": {
        "padding_top": 50,
        "padding_bottom": 50,
        "eyebrow": "Common questions",
        "heading": "Before you <em>decide</em>."
      },
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "Will this sting my reactive skin?",
            "answer": "<p>No. Zero essential oils, zero fragrance, zero known irritants. If your skin reacts — which it shouldn't — 60-day full refund.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "When will I see results?",
            "answer": "<p>Most customers see a shift between weeks 4 and 8. Full effect stabilizes around week 10–12.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "What if it doesn't work?",
            "answer": "<p>Email us. Within 60 days, any reason, full refund to your account within 24 hours. No forms.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "Is this safe during perimenopause?",
            "answer": "<p>Yes. Hormonal flushing is one of the specific patterns Rosalia was designed for. Several of our longest-term users are perimenopausal women.</p>"
          }
        }
      },
