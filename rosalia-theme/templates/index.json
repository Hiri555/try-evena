    "mechanism": {
      "type": "rosalia-mechanism",
      "settings": {
        "padding_top": 50,
        "padding_bottom": 50,
        "eyebrow": "The Reset Complex™",
        "heading": "Rosacea was never <em>one problem</em>.",
        "lead": "Your skin doesn't flush because of one broken thing.\nIt flushes because five systems misfire at once.\nThe Reset Complex pulls all five. At the same time."
      },
      "blocks": {
        "lever_1": {
          "type": "lever",
          "settings": {
            "number": "01",
            "name": "Alarm",
            "emotional_line": "\"The overreaction that finally quiets.\"",
            "mechanism": "Calms the immune misread at the source — before it cascades into visible redness.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M12 3 3 8l9 5 9-5-9-5z\"/><path d=\"M3 13l9 5 9-5\"/><path d=\"M3 17l9 5 9-5\"/></svg>"
          }
        },
        "lever_2": {
          "type": "lever",
          "settings": {
            "number": "02",
            "name": "Nerves",
            "emotional_line": "\"Triggers that stop being triggers.\"",
            "mechanism": "Reduces nerve hypersensitivity so heat, stress, wine no longer set the fire.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M13 2 4 14h6l-1 8 9-12h-6l1-8z\"/></svg>"
          }
        },
        "lever_3": {
          "type": "lever",
          "settings": {
            "number": "03",
            "name": "Wall",
            "emotional_line": "\"Vessels that stop broadcasting.\"",
            "mechanism": "Steadies the vascular amplifier — the physical mechanism behind the flush.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 2v4M12 18v4M2 12h4M18 12h4\"/></svg>"
          }
        },
        "lever_4": {
          "type": "lever",
          "settings": {
            "number": "04",
            "name": "Door",
            "emotional_line": "\"The barrier harsh actives stole — rebuilt.\"",
            "mechanism": "Restores the compromised skin barrier. This is what everything else depends on.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"3\" width=\"12\" height=\"18\" rx=\"1.5\"/><circle cx=\"14.2\" cy=\"12\" r=\"0.9\"/></svg>"
          }
        },
        "lever_5": {
          "type": "lever",
          "settings": {
            "number": "05",
            "name": "Loop",
            "emotional_line": "\"The cycle finally breaks.\"",
            "mechanism": "Interrupts the anxiety-flush-anxiety spiral that keeps it going.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M20 12a8 8 0 1 1-2.34-5.66\"/><path d=\"M20 3v4h-4\"/></svg>"
          }
        }
      },
      "block_order": [
