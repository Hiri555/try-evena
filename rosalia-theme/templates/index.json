    "results": {
      "type": "rosalia-results",
      "settings": {
        "padding_top": 50,
        "padding_bottom": 50,
        "eyebrow": "Real results",
        "heading": "They stopped hiding. <em>Here's what changed.</em>",
        "lead": "In their own words.",
        "show_aggregate": false,
        "aggregate_score": "",
