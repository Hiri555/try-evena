      "blocks": {
        "res_1": {
          "type": "result_card",
          "settings": {
            "image": "shopify://shop_images/rosalia-review-camille.png",
            "rating": 5,
            "quote": "My cheeks stopped burning at 4pm.",
            "comment": "<p>I stopped checking my face before meetings. By week six the 4pm burn just didn't come. My husband asked if I'd changed foundation — I'd stopped wearing it.</p>",
            "name": "Camille",
            "age": "34",
            "duration": "8 weeks",
            "verified": false
          }
        },
        "res_2": {
          "type": "result_card",
          "settings": {
            "image": "shopify://shop_images/rosalia-review-emily.png",
            "rating": 5,
            "quote": "Foundation coverage cut in half.",
            "comment": "<p>Two pumps of foundation down to half a pump of tinted moisturizer. I'm not 'glowing' — I'm just normal. And normal is everything when you've been red for a decade.</p>",
            "name": "Emily",
            "age": "42",
            "duration": "10 weeks",
            "verified": false
          }
        },
        "res_3": {
          "type": "result_card",
          "settings": {
            "image": "shopify://shop_images/rosalia-review-sarah.png",
            "rating": 5,
            "quote": "First serum that didn't sting.",
            "comment": "<p>First serum in six years that didn't sting going on. Week three, I stopped bracing before I applied it. Week six, I forgot I ever used to.</p>",
            "name": "Sarah",
            "age": "38",
            "duration": "6 weeks",
            "verified": false
          }
        },
        "res_4": {
          "type": "result_card",
          "settings": {
            "image": "shopify://shop_images/rosalia-review-laura.png",
            "rating": 5,
            "quote": "The 3pm flush stopped happening.",
            "comment": "<p>The 3pm flush used to be my office nickname. Twelve weeks in, it shows up maybe once a week — mild, gone in minutes. I don't plan meetings around my face anymore.</p>",
            "name": "Laura",
            "age": "45",
            "duration": "12 weeks",
            "verified": false
          }
        },
        "res_5": {
          "type": "result_card",
          "settings": {
            "image": "shopify://shop_images/rosalia-review-nadia.png",
            "rating": 5,
            "quote": "My dermatologist noticed.",
            "comment": "<p>My dermatologist paused mid-exam and asked what I'd changed. Sixteen weeks of this, nothing else. She wrote the name down.</p>",
            "name": "Nadia",
            "age": "51",
            "duration": "16 weeks",
            "verified": false
          }
        }
      },
