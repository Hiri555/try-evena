{%- render 'rosalia-tokens' -%}
{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background | default: 'var(--rosalia-cream)' }};
    color: {{ section.settings.section_text_color | default: 'var(--rosalia-dark)' }};
    --rosalia-accent: {{ section.settings.accent_color | default: '#C4718E' }};
    --rosalia-accent-deep: {{ section.settings.accent_deep | default: '#7A3A54' }};

    /* Impact gallery variables — required for the media carousel to lay out horizontally */
    --product-grid: auto / minmax(0, 1fr);
    --product-gallery-media-list-grid: auto / auto-flow {% if section.settings.mobile_carousel_control == 'free_scroll' %}{% if section.settings.mobile_media_size == 'expanded' %}84vw{% else %}73vw{% endif %}{% else %}100%{% endif %};
    --product-gallery-media-list-gap: {% if section.settings.mobile_media_size == 'expanded' %}var(--spacing-0-5){% else %}var(--grid-gutter){% endif %};
  }
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      --product-gallery-media-list-grid: {% if section.settings.desktop_media_layout contains 'grid' %}auto-flow dense / repeat(2, minmax(0, 1fr)){% else %}auto / auto-flow 100%{% endif %};
      --product-gallery-media-list-gap: calc(var(--grid-gutter) / 2);
    }
  }
  /* ── Gallery: thumbnails + tap-to-fullscreen ───────────
     Impact lays the thumbnails out as a grid with fixed
     `grid-auto-columns`, so the track width — not the button
     width — is what sizes a thumbnail. */
  #shopify-section-{{ section.id }} .product-gallery__thumbnail-list {
    grid-auto-columns: 60px;
    gap: 8px;
    align-items: start;
  }
  #shopify-section-{{ section.id }} .product-gallery__thumbnail {
    height: 60px;
    border-radius: 10px;
    overflow: hidden;
    background: var(--rosalia-white);
    border: 1px solid rgba(122, 58, 84, .12);
    opacity: .58;
    transition: opacity .28s var(--rosalia-ease), border-color .28s var(--rosalia-ease);
  }
  /* Impact underlines the active thumbnail; we use a ring instead */
  #shopify-section-{{ section.id }} .product-gallery__thumbnail::after { display: none; }
  #shopify-section-{{ section.id }} .product-gallery__thumbnail:hover { opacity: .85; }
  #shopify-section-{{ section.id }} .product-gallery__thumbnail[aria-current='true'] {
    opacity: 1;
    border-color: var(--rosalia-accent);
    box-shadow: 0 0 0 1px var(--rosalia-accent);
  }
  #shopify-section-{{ section.id }} .product-gallery__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 9px;
  }
  #shopify-section-{{ section.id }} .product-gallery__media[data-media-type='image'] img { cursor: zoom-in; }
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .product-gallery__thumbnail-list { grid-auto-columns: 68px; gap: 8px; }
    #shopify-section-{{ section.id }} .product-gallery__thumbnail { height: 68px; }
  }

  #shopify-section-{{ section.id }} .rosalia-product {
    max-width: 1280px;
    margin: 0 auto;
    padding: 20px 48px 44px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .rosalia-product {
      {%- assign media_ratio = section.settings.desktop_media_width | default: 50 | divided_by: 50.0 -%}
      grid-template-columns: minmax(0, {{ media_ratio }}fr) minmax(0, {{ 2.0 | minus: media_ratio }}fr);
      gap: 56px;
      align-items: start;
    }
    #shopify-section-{{ section.id }} .rosalia-buybox { position: sticky; top: 32px; }
  }

  /* ── Buy box ─────────────────────────────────────────── */
  #shopify-section-{{ section.id }} .rosalia-eyebrow {
    font-family: var(--rosalia-font-sans);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rosalia-accent);
    font-weight: 500;
    margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .rosalia-title {
    font-family: var(--rosalia-font-serif);
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  #shopify-section-{{ section.id }} .rosalia-subtitle {
    font-family: var(--rosalia-font-serif);
    font-style: italic;
    font-size: 17px;
    color: var(--rosalia-gray);
    line-height: 1.45;
    margin: 0 0 22px;
  }
  #shopify-section-{{ section.id }} .rosalia-tag-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
  #shopify-section-{{ section.id }} .rosalia-tag-pill {
    padding: 5px 12px;
    border: 1px solid var(--rosalia-pink-light);
    border-radius: 100px;
    background: var(--rosalia-white);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--rosalia-accent-deep);
  }
  #shopify-section-{{ section.id }} .rosalia-benefits { display: grid; gap: 12px; margin-bottom: 26px; }
  #shopify-section-{{ section.id }} .rosalia-benefit { display: flex; gap: 11px; align-items: flex-start; }
  #shopify-section-{{ section.id }} .rosalia-benefit-icon {
    flex: 0 0 28px; width: 28px; height: 28px; border-radius: 9px;
    background: var(--rosalia-pink-light); color: var(--rosalia-accent-deep);
    display: flex; align-items: center; justify-content: center;
    margin-top: -2px;
  }
  #shopify-section-{{ section.id }} .rosalia-benefit-icon svg {
    width: 16px; height: 16px;
    fill: none; stroke: currentColor;
    stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round;
  }
  #shopify-section-{{ section.id }} .rosalia-benefit-text { font-size: 13.5px; line-height: 1.45; padding-top: 3px; }
  #shopify-section-{{ section.id }} .rosalia-benefit-text p { margin: 0; }

  /* Symptom picker */
  #shopify-section-{{ section.id }} .rosalia-symptom-section { display: block; margin-bottom: 26px; }
  #shopify-section-{{ section.id }} .rosalia-symptom-head {
    display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 4px;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-hint {
    font-family: var(--rosalia-font-serif);
    font-style: italic;
    font-size: 12.5px;
    color: var(--rosalia-gray);
    margin: 0 0 12px;
    line-height: 1.45;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-label {
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-link {
    font-family: var(--rosalia-font-serif); font-style: italic; font-size: 12px;
    color: var(--rosalia-accent); text-decoration: none;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-card {
    background: var(--rosalia-white);
    border: 1px solid var(--rosalia-pink-light);
    border-radius: 14px;
    padding: 8px 8px 12px;
    cursor: pointer;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 9px;
    transition: border-color 0.3s var(--rosalia-ease), transform 0.3s var(--rosalia-ease), box-shadow 0.3s var(--rosalia-ease);
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-card:hover {
    border-color: var(--rosalia-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(122, 58, 84, 0.08);
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-card-img {
    width: 100%; aspect-ratio: 1 / 1; border-radius: 10px;
    background: linear-gradient(135deg, var(--rosalia-beige), var(--rosalia-pink-light));
    overflow: hidden; display: flex; align-items: center; justify-content: center;
    font-size: 9px; font-style: italic; color: var(--rosalia-gray-2); line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .rosalia-symptom-card-name {
    font-size: 11.5px; font-weight: 600; letter-spacing: 0.01em; line-height: 1.25;
    text-wrap: balance; margin-top: auto; color: var(--rosalia-dark);
  }

  /* Bundle tiers */
  #shopify-section-{{ section.id }} .rosalia-tiers { display: grid; gap: 10px; margin-bottom: 20px; }
  #shopify-section-{{ section.id }} .rosalia-tiers-label {
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; margin-bottom: 2px;
  }
  #shopify-section-{{ section.id }} .rosalia-tier {
    position: relative;
    display: flex; align-items: center; gap: 12px;
    background: var(--rosalia-white);
    border: 1.5px solid var(--rosalia-pink-light);
    border-radius: 12px;
    padding: 14px 16px;
    cursor: pointer;
    transition: all 0.3s var(--rosalia-ease);
  }
  #shopify-section-{{ section.id }} .rosalia-tier:hover { border-color: var(--rosalia-accent); }
  #shopify-section-{{ section.id }} .rosalia-tier--recommended { border-color: var(--rosalia-accent); }
  #shopify-section-{{ section.id }} .rosalia-tier input { position: absolute; opacity: 0; pointer-events: none; }
  #shopify-section-{{ section.id }} .rosalia-tier-radio {
    flex: 0 0 16px; width: 16px; height: 16px; border-radius: 50%;
    border: 2px solid var(--rosalia-gray-3); transition: all 0.2s var(--rosalia-ease);
  }
  #shopify-section-{{ section.id }} .rosalia-tier input:checked ~ .rosalia-tier-radio {
    border-color: var(--rosalia-accent-deep);
    box-shadow: inset 0 0 0 3.5px var(--rosalia-white);
    background: var(--rosalia-accent-deep);
  }
  #shopify-section-{{ section.id }} .rosalia-tier:has(input:checked) {
    border-color: var(--rosalia-accent-deep);
    box-shadow: 0 4px 20px rgba(122, 58, 84, 0.08);
  }
  #shopify-section-{{ section.id }} .rosalia-tier-badge {
    position: absolute; top: -9px; right: 14px;
    background: var(--rosalia-accent-deep); color: var(--rosalia-cream);
    font-size: 8.5px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600;
    padding: 3px 9px; border-radius: 100px;
  }
  #shopify-section-{{ section.id }} .rosalia-tier-body { flex: 1 1 auto; min-width: 0; }
  #shopify-section-{{ section.id }} .rosalia-tier-name { font-size: 13.5px; font-weight: 600; }
  /* Per-unit price — the strongest lever on multi-bottle tiers, so it
     reads as data, not as a whispered aside */
  #shopify-section-{{ section.id }} .rosalia-tier-sub {
    font-family: var(--rosalia-font-sans);
    font-size: 11px; font-weight: 600; letter-spacing: .02em;
    color: var(--rosalia-accent);
    margin-top: 2px;
  }
  #shopify-section-{{ section.id }} .rosalia-tier-price { text-align: right; }
  #shopify-section-{{ section.id }} .rosalia-tier-price-current { font-size: 15px; font-weight: 600; }
  #shopify-section-{{ section.id }} .rosalia-tier-price-compare {
    font-size: 11.5px; color: var(--rosalia-gray-2); text-decoration: line-through;
  }

  /* CTA + ship + guarantee */
  #shopify-section-{{ section.id }} .rosalia-cta {
    position: relative;
    overflow: hidden;
    width: 100%;
    display: flex; align-items: center; justify-content: center; gap: 10px;
    background: var(--rosalia-accent-deep);
    color: var(--rosalia-cream);
    border: none;
    border-radius: {% if section.settings.cta_shape == 'squared' %}4px{% else %}100px{% endif %};
    padding: 18px 28px;
    font-family: var(--rosalia-font-sans);
    font-size: 13.5px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600;
    cursor: pointer;
    transition: background .4s var(--rosalia-ease), transform .2s var(--rosalia-ease), box-shadow .3s var(--rosalia-ease);
    margin-bottom: 14px;
  }
  /* Soft sheen so the fill doesn't read flat */
  #shopify-section-{{ section.id }} .rosalia-cta::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, .07) 0%, transparent 62%);
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .rosalia-cta:hover {
    background: var(--rosalia-wine);
    transform: translateY(-1px);
    box-shadow: 0 10px 26px rgba(75, 21, 40, .18);
  }
  #shopify-section-{{ section.id }} .rosalia-cta:active { transform: translateY(0); box-shadow: none; }

  /* Shop Pay / Apple Pay buttons rendered by Shopify */
  #shopify-section-{{ section.id }} .shopify-payment-button { margin: -4px 0 14px; }
  #shopify-section-{{ section.id }} .shopify-payment-button__button {
    border-radius: {% if section.settings.cta_shape == 'squared' %}4px{% else %}100px{% endif %} !important;
    font-family: var(--rosalia-font-sans) !important;
    font-size: 14px !important;
    min-height: 52px !important;
  }
  #shopify-section-{{ section.id }} .shopify-payment-button__more-options {
    font-family: var(--rosalia-font-sans);
    font-size: 12px;
    color: var(--rosalia-gray);
  }
  #shopify-section-{{ section.id }} .rosalia-cta[disabled] { opacity: 0.5; cursor: not-allowed; }
  #shopify-section-{{ section.id }} .rosalia-cta.is-loading { opacity: 0.7; cursor: wait; }
  #shopify-section-{{ section.id }} .rosalia-cta-arrow { transition: transform 0.3s var(--rosalia-ease); }
  #shopify-section-{{ section.id }} .rosalia-cta:hover .rosalia-cta-arrow { transform: translateX(3px); }
  #shopify-section-{{ section.id }} .rosalia-delivery {
    display: flex; align-items: flex-start; justify-content: center; gap: 9px;
    font-family: var(--rosalia-font-sans);
    font-size: 12px; line-height: 1.5; color: var(--rosalia-gray);
    margin: -4px 0 16px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .rosalia-delivery-text { text-wrap: balance; }
  #shopify-section-{{ section.id }} .rosalia-delivery strong {
    color: var(--rosalia-dark); font-weight: 600;
    white-space: nowrap; /* never split "August 10" across lines */
  }
  #shopify-section-{{ section.id }} .rosalia-delivery-dot {
    flex: 0 0 7px;
    width: 7px; height: 7px; border-radius: 50%;
    margin-top: 6px;
    background: #4F7A5A;
    box-shadow: 0 0 0 3px rgba(79, 122, 90, .16);
  }
  #shopify-section-{{ section.id }} .rosalia-review-stars { margin: -2px 0 14px; }
  #shopify-section-{{ section.id }} .rosalia-review-stars .jdgm-prev-badge {
    display: flex; align-items: center; gap: 8px;
    font-family: var(--rosalia-font-sans);
    font-size: 13px; color: var(--rosalia-gray);
  }
  #shopify-section-{{ section.id }} .rosalia-review-stars .jdgm-prev-badge__stars { color: var(--rosalia-accent) !important; }

  #shopify-section-{{ section.id }} .rosalia-ship {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-bottom: 18px;
  }
  #shopify-section-{{ section.id }} .rosalia-ship-item {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; color: var(--rosalia-gray);
  }
  #shopify-section-{{ section.id }} .rosalia-ship-dot {
    width: 5px; height: 5px; border-radius: 50%; background: var(--rosalia-pink-mid);
  }
  #shopify-section-{{ section.id }} .rosalia-guarantee {
    color: inherit; text-decoration: none; -webkit-tap-highlight-color: rgba(0,0,0,.05);
    display: flex; gap: 12px; align-items: flex-start;
    background: rgba(247, 228, 234, .34);
    border: 1px solid rgba(196, 113, 142, .22);
    border-radius: 12px;
    padding: 15px 16px;
    margin-bottom: 18px;
  }
  #shopify-section-{{ section.id }} .rosalia-guarantee-icon {
    flex: 0 0 36px; width: 36px; height: 36px; border-radius: 10px;
    background: rgba(122, 58, 84, .08); color: var(--rosalia-accent-deep);
    display: flex; align-items: center; justify-content: center;
  }
  #shopify-section-{{ section.id }} .rosalia-guarantee-copy {
    font-family: var(--rosalia-font-sans);
    font-size: 13px; line-height: 1.5; color: var(--rosalia-dark);
  }
  #shopify-section-{{ section.id }} .rosalia-guarantee-copy strong {
    display: block;
    font-weight: 600; font-size: 11px;
    letter-spacing: .07em; text-transform: uppercase;
    color: var(--rosalia-accent-deep);
    margin-bottom: 3px;
  }
  #shopify-section-{{ section.id }} .rosalia-guarantee-copy p { margin: 0; }
  #shopify-section-{{ section.id }} .rosalia-app-zone { margin-bottom: 18px; }
  #shopify-section-{{ section.id }} .rosalia-app-zone:has(.rosalia-app-zone-label) {
    border: 1.5px dashed var(--rosalia-gray-3);
    border-radius: 12px;
    padding: 14px 16px;
  }
  #shopify-section-{{ section.id }} .rosalia-app-zone:empty { display: none; }
  #shopify-section-{{ section.id }} .rosalia-app-zone-label {
    font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--rosalia-gray-2);
  }
  #shopify-section-{{ section.id }} .rosalia-richtext { margin-bottom: 18px; font-size: 13.5px; line-height: 1.55; }

  /* ── Symptom modal ───────────────────────────────────── */
  #shopify-section-{{ section.id }} .rosalia-symptom-modal-overlay {
    position: fixed; inset: 0; z-index: 9998;
    background: rgba(31, 26, 28, 0.55);
    display: flex; align-items: center; justify-content: center;
    padding: 24px;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-modal-box {
    background: var(--rosalia-cream);
    border-radius: 16px;
    max-width: 680px; width: 100%;
    max-height: 86vh; overflow-y: auto;
    padding: 32px;
    position: relative;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-modal-x {
    position: absolute; top: 14px; right: 14px;
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--rosalia-pink-light); color: var(--rosalia-accent-deep);
    border: none; cursor: pointer; font-size: 17px; line-height: 1;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-tabs {
    display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; padding-right: 40px;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-tab {
    padding: 7px 14px; border-radius: 100px;
    border: 1.5px solid var(--rosalia-pink-light);
    background: var(--rosalia-white);
    font-size: 11px; font-weight: 600; letter-spacing: 0.04em;
    cursor: pointer; transition: all 0.25s var(--rosalia-ease);
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-tab[aria-selected="true"] {
    background: var(--rosalia-accent-deep); color: var(--rosalia-cream); border-color: var(--rosalia-accent-deep);
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-panel[hidden] { display: none; }
  #shopify-section-{{ section.id }} .rosalia-symptom-panel-title {
    font-family: var(--rosalia-font-serif); font-size: 26px; font-weight: 600; margin: 0 0 16px;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-visuals {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-visual {
    aspect-ratio: 1 / 1; border-radius: 10px; overflow: hidden;
    background: linear-gradient(135deg, var(--rosalia-beige), var(--rosalia-pink-light));
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-style: italic; color: var(--rosalia-gray-2); text-align: center;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-visual img { width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .rosalia-symptom-desc { font-size: 13.5px; line-height: 1.6; color: var(--rosalia-gray); margin-bottom: 16px; }
  #shopify-section-{{ section.id }} .rosalia-symptom-levers { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  #shopify-section-{{ section.id }} .rosalia-symptom-lever-tag {
    padding: 4px 10px; border-radius: 100px;
    background: var(--rosalia-pink-light); color: var(--rosalia-accent-deep);
    font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-mech {
    font-size: 12.5px; line-height: 1.55; margin-bottom: 16px;
    padding: 12px 14px; border-left: 2px solid var(--rosalia-pink-mid);
    background: var(--rosalia-white); border-radius: 0 10px 10px 0;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-ings { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
  #shopify-section-{{ section.id }} .rosalia-symptom-ing {
    display: flex; align-items: center; gap: 8px;
    background: var(--rosalia-white); border: 1px solid var(--rosalia-pink-light);
    border-radius: 10px; padding: 8px 12px;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-ing-img {
    width: 30px; height: 30px; border-radius: 6px; overflow: hidden;
    background: var(--rosalia-pink-light); flex: 0 0 30px;
  }
  #shopify-section-{{ section.id }} .rosalia-symptom-ing-img img { width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .rosalia-symptom-ing-name { font-size: 11.5px; font-weight: 600; }
  #shopify-section-{{ section.id }} .rosalia-symptom-ing-role { font-size: 10px; color: var(--rosalia-gray); }
  #shopify-section-{{ section.id }} .rosalia-symptom-outcome {
    font-family: var(--rosalia-font-serif); font-style: italic;
    font-size: 15px; line-height: 1.5; color: var(--rosalia-accent-deep);
  }

  @media (max-width: 749px) {
    /* ── Mission 3 — epuration mobile (CRO V2, 2026-08-18) ──────────
       Objectif : remonter le bundle et l ATC. Rien ici ne sort de cette
       media query, le desktop est donc strictement inchange. */
    #shopify-section-{{ section.id }} .rosalia-product { padding: 10px 20px 20px; gap: 16px; }
    #shopify-section-{{ section.id }} .rosalia-symptom-section { margin-bottom: 14px; }
    #shopify-section-{{ section.id }} .rosalia-benefits { gap: 10px; margin-bottom: 14px; }
    #shopify-section-{{ section.id }} .rosalia-ship { gap: 12px; margin-bottom: 10px; }

    /* ── Mission 1 — symptom picker : rangee de pills a scroll horizontal ──
       La grille 2x2 avec photos coutait ~330px de hauteur et repoussait le
       bundle et l ATC hors ecran. Les pills tiennent sur 40px, une ligne.
       Le markup et le JS de selection sont conserves : seul le rendu change. */
    #shopify-section-{{ section.id }} .rosalia-symptom-grid {
      display: flex;
      flex-wrap: nowrap;
      gap: 8px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      /* plein bord a bord, mais la 1re pill reste alignee sur le contenu (20px) */
      margin-inline: -20px;
      padding: 2px 20px;
    }
    #shopify-section-{{ section.id }} .rosalia-symptom-grid::-webkit-scrollbar { display: none; }

    #shopify-section-{{ section.id }} .rosalia-symptom-card {
      flex: 0 0 auto;
      scroll-snap-align: start;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      height: 40px;
      padding: 0 14px;
      border-radius: 999px;
      text-align: left;
      white-space: nowrap;
      touch-action: manipulation;
    }
    #shopify-section-{{ section.id }} .rosalia-symptom-card:hover { transform: none; box-shadow: none; }
    #shopify-section-{{ section.id }} .rosalia-symptom-card-img {
      flex: 0 0 22px; width: 22px; height: 22px;
      aspect-ratio: auto; border-radius: 50%; font-size: 0;
    }
    #shopify-section-{{ section.id }} .rosalia-symptom-card-name {
      font-size: 13px; line-height: 1; margin-top: 0;
    }
    /* pill selectionnee — plum sur cream */
    #shopify-section-{{ section.id }} .rosalia-symptom-card[aria-pressed="true"] {
      background: var(--rosalia-accent-deep, #7A3A54);
      border-color: var(--rosalia-accent-deep, #7A3A54);
    }
    #shopify-section-{{ section.id }} .rosalia-symptom-card[aria-pressed="true"] .rosalia-symptom-card-name {
      color: var(--rosalia-cream, #FAF5F0);
    }

    /* Le detail s ouvre en panneau SOUS les pills, plus en modale plein ecran.
       La modale est deja rendue apres la grille dans le markup : il suffit de
       la sortir du flux fixe. L attribut [hidden] continue de piloter
       l affichage via la regle globale [hidden]{display:none!important}. */
    #shopify-section-{{ section.id }} .rosalia-symptom-modal-overlay {
      position: static; inset: auto; z-index: auto;
      display: block; background: none; padding: 0;
    }
    #shopify-section-{{ section.id }} .rosalia-symptom-modal-box {
      border-radius: 14px;
      max-height: none; overflow: visible;
      padding: 16px 16px 18px;
      animation: rosalia-symptom-reveal 220ms var(--rosalia-ease) both;
    }
    /* Croix de fermeture — 44x44, plum sur cream. Elle etait a 28px en
       pink-light sur fond cream : invisible et sous la cible tactile. */
    #shopify-section-{{ section.id }} .rosalia-symptom-modal-x {
      top: 12px; right: 12px;
      width: 44px; height: 44px;
      border: none; border-radius: 50%;
      background: var(--rosalia-accent-deep, #7A3A54);
      color: var(--rosalia-cream, #FAF5F0);
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; line-height: 1; padding: 0;
      cursor: pointer;
    }
    #shopify-section-{{ section.id }} .rosalia-symptom-modal-x:hover,
    #shopify-section-{{ section.id }} .rosalia-symptom-modal-x:focus-visible {
      background: #4B1528;
      outline: 2px solid #C4718E;
      outline-offset: 2px;
    }
    /* les onglets font doublon avec les pills */
    #shopify-section-{{ section.id }} .rosalia-symptom-tabs { display: none; }
    #shopify-section-{{ section.id }} .rosalia-symptom-panel-title { font-size: 21px; margin-bottom: 12px; padding-right: 60px; }
    #shopify-section-{{ section.id }} .rosalia-symptom-visuals { grid-template-columns: 1fr; gap: 10px; }
    #shopify-section-{{ section.id }} .rosalia-symptom-visual { aspect-ratio: 4 / 3; }
    #shopify-section-{{ section.id }} .rosalia-symptom-ings { gap: 8px; }
    #shopify-section-{{ section.id }} .rosalia-symptom-ing { flex: 1 1 100%; }

    @keyframes rosalia-symptom-reveal {
      from { opacity: 0; transform: translateY(-6px); }
      to   { opacity: 1; transform: none; }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .rosalia-symptom-modal-box { animation: none; }
    #shopify-section-{{ section.id }} .rosalia-symptom-card,
    #shopify-section-{{ section.id }} .rosalia-tier,
    #shopify-section-{{ section.id }} .rosalia-cta,
    #shopify-section-{{ section.id }} .rosalia-cta-arrow { transition: none; }
  }

  /* ── "Looking for more answers?" ───────────────────────
     Sits directly under the guarantee card, still inside the buy box, so the
     three biggest objections are answered without leaving the CTA behind. */
  #shopify-section-{{ section.id }} .rosalia-more {
    margin-top: 14px;
    padding: 18px 18px 12px;
    background: var(--rosalia-white);
    border: 1px solid rgba(196, 113, 142, .22);
    border-radius: 14px;
  }
  #shopify-section-{{ section.id }} .rosalia-more-heading {
    font-family: var(--rosalia-font-serif);
    font-size: 17px; font-weight: 500; margin: 0 0 12px;
    color: var(--rosalia-dark);
  }
  #shopify-section-{{ section.id }} .rosalia-more-input {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 11px 15px; border-radius: 100px;
    border: 1px solid var(--rosalia-pink-light); background: var(--rosalia-cream);
    color: var(--rosalia-gray); text-decoration: none; font-size: 13.5px;
    transition: border-color .25s var(--rosalia-ease);
  }
  #shopify-section-{{ section.id }} .rosalia-more-input:hover { border-color: var(--rosalia-pink); }
  #shopify-section-{{ section.id }} .rosalia-more-input span { min-width: 0; overflow-wrap: anywhere; }
  #shopify-section-{{ section.id }} .rosalia-more-quick { margin-top: 10px; }
  #shopify-section-{{ section.id }} .rosalia-more-item { border-top: 1px solid var(--rosalia-pink-light); }
  #shopify-section-{{ section.id }} .rosalia-more-item:first-child { border-top: 0; }
  #shopify-section-{{ section.id }} .rosalia-more-q {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 12px 0; cursor: pointer; list-style: none;
    font-size: 13.5px; font-weight: 500; color: var(--rosalia-plum);
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .rosalia-more-q::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .rosalia-more-plus {
    flex: 0 0 auto; font-size: 17px; color: var(--rosalia-pink);
    transition: transform .3s var(--rosalia-ease);
  }
  #shopify-section-{{ section.id }} .rosalia-more-item[open] .rosalia-more-plus { transform: rotate(45deg); }
  #shopify-section-{{ section.id }} .rosalia-more-a {
    padding: 0 0 12px; font-size: 13px; line-height: 1.6; color: var(--rosalia-gray);
  }
  #shopify-section-{{ section.id }} .rosalia-more-a p { margin: 0 0 9px; }
  #shopify-section-{{ section.id }} .rosalia-more-a p:last-child { margin-bottom: 0; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .rosalia-more-plus { transition: none; }
  }
</style>

<div {% render 'section-properties', tight: true %}>
  <div class="product rosalia-product">
    {%- if section.settings.product != blank -%}
      {%- assign rp_product = section.settings.product -%}
    {%- else -%}
      {%- assign rp_product = product -%}
    {%- endif -%}

    {%- capture product_form_id -%}product-form-{{ rp_product.id }}-{{ section.id }}{%- endcapture -%}

    {%- comment -%} Gallery — reuses Impact's gallery snippet unchanged {%- endcomment -%}
    <div class="rosalia-gallery-col">
      {%- if rp_product.media.size > 0 -%}
        {%- render 'product-gallery', product: rp_product -%}
      {%- else -%}
        <div class="product-gallery">
          {{- 'product-1' | placeholder_svg_tag: 'placeholder rounded' -}}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Buy box {%- endcomment -%}
    {%- comment -%}
      Anchor target. The header CTA points here so that clicking it on the
      product page scrolls to the buy box instead of re-navigating to the
      page you are already on (which looked like a dead button).
    {%- endcomment -%}
    <div class="product-info rosalia-buybox" id="rosalia-buybox">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'eyebrow' -%}
            {%- assign eyebrow_text = block.settings.text | default: rp_product.metafields.rosalia.eyebrow -%}
            {%- if eyebrow_text != blank -%}
              <div class="rosalia-eyebrow" {{ block.shopify_attributes }}>{{ eyebrow_text }}</div>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class="rosalia-title" {{ block.shopify_attributes }}>{{ rp_product.title }}</h1>
            {%- if section.settings.enable_judgeme -%}
              {%- comment -%} Renders only once the Judge.me app is installed {%- endcomment -%}
              <div class="rosalia-review-stars">
                {%- render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', jm_style: '', concierge_install: true, product: rp_product -%}
              </div>
            {%- endif -%}

          {%- when 'subtitle' -%}
            {%- assign subtitle_text = block.settings.text | default: rp_product.metafields.rosalia.subtitle -%}
            {%- if subtitle_text != blank -%}
              <p class="rosalia-subtitle" {{ block.shopify_attributes }}>{{ subtitle_text }}</p>
            {%- endif -%}

          {%- when 'tag_pills' -%}
            {%- assign pills = rp_product.metafields.rosalia.tag_pills.value -%}
            {%- if pills.size > 0 -%}
              <div class="rosalia-tag-pills" {{ block.shopify_attributes }}>
                {%- for pill in pills -%}
                  <span class="rosalia-tag-pill">{{ pill }}</span>
                {%- endfor -%}
              </div>
            {%- endif -%}

          {%- when 'benefits' -%}
            {%- assign benefits = rp_product.metafields.rosalia.benefits.value -%}
            {%- if benefits.size > 0 -%}
              <div class="rosalia-benefits" {{ block.shopify_attributes }}>
                {%- comment -%}
                  A benefit is either a plain HTML string or an object
                  { icon: '<svg…>', text: '…' } so each line can carry an icon
                  that actually illustrates it instead of a row of identical ticks.
                {%- endcomment -%}
                {%- for benefit in benefits -%}
                  {%- if benefit.text -%}
                    {%- assign b_text = benefit.text -%}
                    {%- assign b_icon = benefit.icon -%}
                  {%- else -%}
                    {%- assign b_text = benefit -%}
                    {%- assign b_icon = '' -%}
                  {%- endif -%}
                  <div class="rosalia-benefit">
                    <div class="rosalia-benefit-icon">
                      {%- if b_icon != blank -%}
                        {{ b_icon }}
                      {%- elsif block.settings.icon_svg != blank -%}
                        {{ block.settings.icon_svg }}
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9.5 18 20 6.5"/></svg>
                      {%- endif -%}
                    </div>
                    <div class="rosalia-benefit-text">{{ b_text }}</div>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}

          {%- when 'symptom_picker' -%}
            {%- assign symptoms = rp_product.metafields.rosalia.symptoms.value -%}
            {%- if symptoms.size > 0 -%}
              <rosalia-symptom-picker class="rosalia-symptom-section" {{ block.shopify_attributes }}>
                <div class="rosalia-symptom-head">
                  <span class="rosalia-symptom-label">{{ block.settings.label | default: 'What is your skin doing?' }}</span>
                  {%- if block.settings.link_text != blank -%}
                    <a href="{{ block.settings.link_url }}" class="rosalia-symptom-link">{{ block.settings.link_text }}</a>
                  {%- endif -%}
                </div>
                {%- if block.settings.hint != blank -%}
                  <p class="rosalia-symptom-hint">{{ block.settings.hint }}</p>
                {%- endif -%}
                <div class="rosalia-symptom-grid">
                  {%- for sym in symptoms -%}
                    <button class="rosalia-symptom-card" type="button" data-index="{{ forloop.index0 }}" aria-haspopup="dialog">
                      <div class="rosalia-symptom-card-img">
                        {%- if sym.card_photo != blank -%}
                          {{ sym.card_photo | image_url: width: 560 | image_tag: loading: 'lazy', alt: sym.title, widths: '160,240,320,480,560', sizes: '(max-width: 749px) 46vw, 180px' }}
                        {%- else -%}
                          <span>{{ sym.title }}</span>
                        {%- endif -%}
                      </div>
                      <div class="rosalia-symptom-card-name">{{ sym.title }}</div>
                    </button>
                  {%- endfor -%}
                </div>
                {%- render 'rosalia-symptom-modal', symptoms: symptoms -%}
              </rosalia-symptom-picker>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            {%- render 'variant-picker', product: rp_product, block: block, product_form_id: product_form_id -%}

          {%- comment -%}
            'bundle_tiers' is intentionally no longer offered in the schema.
            It rendered a second offer ladder next to the Kaching Bundles
            app block — two pickers for the same purchase — and its radios
            could overwrite the deal the customer had chosen in Kaching.
            It also could not work as built: the product has a single
            variant, so it only ever drew one radio labelled "Default
            Title". The offer ladder belongs to Kaching, which owns the
            deals, the per-offer stats and the A/B test.
            The branch below stays only so any theme still carrying the
            block in its template does not hard-error while rendering.
          {%- endcomment -%}
          {%- when 'bundle_tiers' -%}
            <div class="rosalia-tiers" {{ block.shopify_attributes }}>
              <div class="rosalia-tiers-label">{{ block.settings.label | default: 'Choose your reset' }}</div>
              {%- assign recommended_id = rp_product.metafields.rosalia.recommended_variant_id.value.id -%}
              {%- for v in rp_product.variants -%}
                <label class="rosalia-tier {% if v.id == recommended_id %}rosalia-tier--recommended{% endif %}">
                  {%- if v.id == recommended_id -%}<div class="rosalia-tier-badge">{{ block.settings.recommended_label | default: 'Recommended' }}</div>{%- endif -%}
                  <input type="radio" name="id" value="{{ v.id }}" form="{{ product_form_id }}" {% if v.id == rp_product.selected_or_first_available_variant.id %}checked{% endif %}>
                  <span class="rosalia-tier-radio" aria-hidden="true"></span>
                  <div class="rosalia-tier-body">
                    <div class="rosalia-tier-name">{{ v.title }}</div>
                    {%- assign v_subtitle = v.metafields.rosalia.subtitle -%}
                    {%- if v_subtitle != blank -%}<div class="rosalia-tier-sub">{{ v_subtitle }}</div>{%- endif -%}
                  </div>
                  <div class="rosalia-tier-price">
                    <div class="rosalia-tier-price-current">{{ v.price | money }}</div>
                    {%- if v.compare_at_price > v.price -%}
                      <div class="rosalia-tier-price-compare">{{ v.compare_at_price | money }}</div>
                    {%- endif -%}
                  </div>
                </label>
              {%- endfor -%}
            </div>

          {%- when 'buy_buttons' -%}
            {%- assign sel_variant = rp_product.selected_or_first_available_variant -%}
            <button
              type="submit"
              form="{{ product_form_id }}"
              class="rosalia-cta"
              name="add"
              data-rosalia-atc
              {% unless sel_variant.available %}disabled{% endunless %}
              {{ block.shopify_attributes }}
            >
              {%- if sel_variant.available -%}
                <span class="rosalia-cta-label">{{ block.settings.button_label | default: 'GET MY FACE BACK' }}</span>
                <span class="rosalia-cta-arrow" aria-hidden="true">→</span>
              {%- else -%}
                {{ 'product.form.sold_out' | t | default: 'Sold out' }}
              {%- endif -%}
            </button>

          {%- when 'delivery_estimate' -%}
            {%- comment -%}
              "Order today — arrives between X and Y" beats "ships in 3-5
              days". Settings are BUSINESS days; the exact weekend-skipping
              dates are computed client-side (also dodges page caching). The
              Liquid render is only a calendar-day fallback for no-JS.
            {%- endcomment -%}
            {%- assign de_min_days = block.settings.min_days | default: 4 -%}
            {%- assign de_max_days = block.settings.max_days | default: 8 -%}
            {%- assign de_now = 'now' | date: '%s' | plus: 0 -%}
            {%- assign de_min_fallback = de_min_days | times: 86400 | plus: de_now | date: '%B %-d' -%}
            {%- assign de_max_fallback = de_max_days | times: 86400 | plus: de_now | date: '%B %-d' -%}
            <div class="rosalia-delivery" data-rosalia-delivery data-min-days="{{ de_min_days }}" data-max-days="{{ de_max_days }}" {{ block.shopify_attributes }}>
              <span class="rosalia-delivery-dot" aria-hidden="true"></span>
              {%- comment -%}
                One text node, not three flex children — otherwise the dates
                become their own flex items and the sentence breaks apart on
                narrow screens.
              {%- endcomment -%}
              <span class="rosalia-delivery-text">Order today &mdash; arrives between <strong data-role="date-min">{{ de_min_fallback }}</strong> and <strong data-role="date-max">{{ de_max_fallback }}</strong></span>
            </div>

          {%- when 'ship_indicators' -%}
            <div class="rosalia-ship" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- assign key = 'text_' | append: i -%}
                {%- assign val = block.settings[key] -%}
                {%- if val != blank -%}
                  <span class="rosalia-ship-item"><span class="rosalia-ship-dot"></span>{{ val }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'trust_badges' -%}
            <div {{ block.shopify_attributes }}>
              {%- render 'rosalia-trust-badges',
                  context: 'pdp',
                  label_1: block.settings.trust_badge_1,
                  label_2: block.settings.trust_badge_2,
                  label_3: block.settings.trust_badge_3,
                  label_4: block.settings.trust_badge_4 -%}
            </div>

          {%- when 'guarantee' -%}
            {%- comment -%}
              CRO V2 - 2026-08-18 - dead clicks sur le bloc garantie (3 en 30 j, Clarity).
              Le bloc etait un <div> inerte : les visiteurs le tapaient pour lire les
              conditions et rien ne se passait. Il devient un lien vers la politique de
              remboursement. Le markup interne et les classes sont inchanges, donc le
              rendu est identique ; seule la balise change (div -> a), avec un reset de
              couleur/decoration dans le CSS pour neutraliser le style de lien par defaut.
              NB : on ne passe volontairement PAS en <details>/<summary> - la copy de
              garantie est actuellement visible, la replier la cacherait derriere un tap.
            {%- endcomment -%}
            <a class="rosalia-guarantee" href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}" {{ block.shopify_attributes }}>
              <span class="rosalia-guarantee-icon">
                {%- render 'rosalia-icons', icon: 'shield-check', size: 20 -%}
              </span>
              <div class="rosalia-guarantee-copy">
                <strong>{{ block.settings.headline | default: '60-day reset guarantee' }}</strong>
                <span>{{ block.settings.text }}</span>
              </div>
            </a>

          {%- when 'more_answers' -%}
            {%- comment -%}
              The input is deliberately not a live search — it routes to
              contact so the prospect never hits a dead end.
            {%- endcomment -%}
            <div class="rosalia-more" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="rosalia-more-heading">{{ block.settings.heading }}</p>
              {%- endif -%}

              <a class="rosalia-more-input" href="{{ block.settings.input_url | default: '/pages/contact' }}">
                <span>{{ block.settings.input_placeholder | default: 'Have questions? Ask here' }}</span>
                {%- render 'rosalia-icons', icon: 'arrow-right', size: 15 -%}
              </a>

              <div class="rosalia-more-quick">
                {%- for i in (1..3) -%}
                  {%- assign more_label_key = 'q' | append: i | append: '_label' -%}
                  {%- assign more_answer_key = 'q' | append: i | append: '_answer' -%}
                  {%- assign more_label = block.settings[more_label_key] -%}
                  {%- assign more_answer = block.settings[more_answer_key] -%}
                  {%- if more_label != blank -%}
                    <details class="rosalia-more-item">
                      <summary class="rosalia-more-q">
                        <span>{{ more_label }}</span>
                        <span class="rosalia-more-plus" aria-hidden="true">+</span>
                      </summary>
                      <div class="rosalia-more-a">{{ more_answer }}</div>
                    </details>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

          {%- when 'app_zone' -%}
            <div class="rosalia-app-zone" {{ block.shopify_attributes }}>
              {%- comment -%}
                The placeholder is a merchant-facing hint. Customers must never
                see it, so it only renders inside the theme editor.
              {%- endcomment -%}
              {%- if request.design_mode and block.settings.label != blank -%}
                <div class="rosalia-app-zone-label">{{ block.settings.label }}</div>
              {%- endif -%}
            </div>

          {%- when 'richtext' -%}
            <div class="rosalia-richtext" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>

          {%- when 'liquid' -%}
            <div class="rosalia-liquid" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

          {%- when '@app' -%}
            {%- render block -%}

        {%- endcase -%}
      {%- endfor -%}

      {%- comment -%}
        Hidden ATC form. The <script> below hijacks the submit as AJAX and
        opens the cart drawer instead of reloading to /cart.
      {%- endcomment -%}
      {%- comment -%}
        `is: 'product-form'` is what wires this form into Impact's own AJAX
        add-to-cart controller. Without it the form does a plain POST and the
        browser navigates to /cart — no drawer, ever.
      {%- endcomment -%}
      {%- form 'product', rp_product, is: 'product-form', id: product_form_id, class: 'rosalia-product-form' -%}
        <input type="hidden" name="id" value="{{ rp_product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
      {%- endform -%}
    </div>
  </div>
</div>

<script src="{{ 'rosalia-main-product.js' | asset_url }}" defer="defer"></script>

<script>
  /* ── Cart drawer opener ────────────────────────────────
     This section's own add-to-cart is handled natively: the form carries
     is="product-form", so Impact submits it over AJAX and opens the drawer.
     Two prerequisites, both of which were missing and are now fixed:
       - settings_data.json must set cart_type to "drawer" (default is
         "popover", which disables the drawer entirely);
       - the drawer element is opened with show(), not open().

     What remains below covers add-to-cart fired by THIRD PARTIES that
     bypass the theme form (Kaching Bundles, Rebuy, Loox, quick-add cards):

       1.  Global fetch monkey-patch — every POST to /cart/add(.js).
       1b. Same for XMLHttpRequest.
       2.  CTA loading state only — no preventDefault, Impact owns the submit. */
  (function() {
    if (window.__rosaliaDrawerHook) return;    /* mount once per document */
    window.__rosaliaDrawerHook = true;

    var ctaBtn = null, ctaLabel = null, ctaText = null;

    function resetCta() {
      if (!ctaBtn) return;
      ctaBtn.classList.remove('is-loading');
      if (ctaLabel && ctaText !== null) ctaLabel.textContent = ctaText;
    }

    function openDrawer() {
      var drawer = document.getElementById('cart-drawer') ||
                   document.querySelector('cart-drawer, cart-notification-drawer');
      if (!drawer) return false;
      /* Impact's drawer element exposes show()/hide(). open() does not exist —
         calling it was why the drawer never appeared. */
      if (typeof drawer.show === 'function') { try { drawer.show(); return true; } catch (e) {} }
      if (typeof drawer.open === 'function') { try { drawer.open(); return true; } catch (e) {} }
      drawer.setAttribute('open', '');
      return true;
    }

    /* Impact's own product-form also opens the drawer, and the interceptors
       below see its /cart/add call too. Debounce so one add = one open. */
    var lastAdd = 0;

    function afterAdd() {
      var now = new Date().getTime();
      if (now - lastAdd < 700) return;
      lastAdd = now;
      resetCta();
      document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      openDrawer();
    }

    /* Layer 1 — global fetch interceptor for /cart/add[.js] */
    var origFetch = window.fetch;
    if (typeof origFetch === 'function') {
      window.fetch = function(input, init) {
        var url = typeof input === 'string' ? input : (input && input.url) || '';
        var method = (init && init.method) || (input && input.method) || 'GET';
        var isAdd = /\/cart\/add(\.js)?(\?|$)/.test(url) && String(method).toUpperCase() === 'POST';
        var p = origFetch.apply(this, arguments);
        if (isAdd) {
          p.then(function(res) {
            if (res && res.ok) { setTimeout(afterAdd, 60); }
          }).catch(function() {});
        }
        return p;
      };
    }

    /* Layer 1b — same for XHR (Kaching / Loox / older apps sometimes use it) */
    var origOpen = XMLHttpRequest.prototype.open;
    var origSend = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.open = function(method, url) {
      this.__rosMethod = method; this.__rosUrl = url || '';
      return origOpen.apply(this, arguments);
    };
    XMLHttpRequest.prototype.send = function() {
      var xhr = this;
      var isAdd = /\/cart\/add(\.js)?(\?|$)/.test(xhr.__rosUrl || '') && String(xhr.__rosMethod || '').toUpperCase() === 'POST';
      if (isAdd) {
        xhr.addEventListener('load', function() { if (xhr.status >= 200 && xhr.status < 300) setTimeout(afterAdd, 60); });
      }
      return origSend.apply(this, arguments);
    };

    /* Layer 2 — CTA loading state only.
       We deliberately do NOT preventDefault here: the form now carries
       is="product-form", so Impact owns the AJAX submit. Hijacking it a
       second time would fire two /cart/add calls for one click. */
    document.addEventListener('submit', function(e) {
      /* CRO V2 fix - 2026-08-18 - form.id DOM clobbering.
         Shopify's form tag emits <input name="id"> inside the product form.
         HTMLFormElement named-property access makes `form.id` resolve to that
         INPUT element instead of the id string, so `form.id.indexOf(...)` threw
         TypeError on every buy-button click (100% of the site's Clarity click
         errors over 30 days). getAttribute('id') is always a string and is
         immune to clobbering, whatever markup an app injects into the form.
         The body is wrapped in try/catch on purpose: this layer only paints a
         loading state, so it must never be able to throw inside a buyer's
         add-to-cart submit. */
      try {
        var form = e.target;
        var formId = (form && typeof form.getAttribute === 'function')
          ? String(form.getAttribute('id') || '')
          : '';
        if (formId.indexOf('product-form-') !== 0) return;
        var btn = document.querySelector('[data-rosalia-atc]');
        if (!btn) return;
        ctaBtn = btn;
        ctaLabel = btn.querySelector('.rosalia-cta-label');
        if (ctaLabel && ctaText === null) ctaText = ctaLabel.textContent;
        btn.classList.add('is-loading');
        if (ctaLabel) ctaLabel.textContent = 'Adding…';
        /* Safety net: never leave the button stuck if nothing comes back. */
        setTimeout(resetCta, 6000);
      } catch (err) {
        if (window.console && console.warn) console.warn('[rosalia] CTA loading state skipped:', err);
      }
    }, true);

    /* Layer 3 — header CTA delegation.
       On the product page the header button linked to the page you were
       already on, so it read as dead. This script ships with this section, so
       it only runs here; on every other page the header link still navigates
       to the product normally.

       We strip the href rather than relying on preventDefault: the theme uses
       an instant-navigation helper that acts on the click before a bubbled
       listener can cancel it. With no href there is nothing to navigate to,
       and the click is forwarded to the real add-to-cart button so both CTAs
       take the exact same Impact AJAX path. */
    function wireHeaderCta() {
      var head = document.querySelector('.rosalia-head-cta');
      if (!head || head.dataset.rosaliaProxy) return;
      head.dataset.rosaliaProxy = '1';
      head.setAttribute('data-no-instant', '');
      head.removeAttribute('href');
      head.setAttribute('role', 'button');
      head.setAttribute('tabindex', '0');
      head.style.cursor = 'pointer';

      function fire(e) {
        var atc = document.querySelector('[data-rosalia-atc]');
        if (!atc || atc.disabled) return;
        e.preventDefault();
        atc.click();
      }
      head.addEventListener('click', fire);
      head.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') fire(e);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', wireHeaderCta);
    } else {
      wireHeaderCta();
    }
  })();
</script>

{% schema %}
{
  "name": "Rosalia — Main product",
  "class": "shopify-section--main-product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave blank on a product template — it will use the current product."
    },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_media_width", "label": "Desktop gallery width (%)", "min": 35, "max": 65, "step": 5, "unit": "%", "default": 50 },
    {
      "type": "select",
      "id": "desktop_media_layout",
      "label": "Desktop gallery layout",
      "options": [
        { "value": "carousel_thumbnails_left", "label": "Carousel + thumbnails left" },
        { "value": "carousel_thumbnails_bottom", "label": "Carousel + thumbnails bottom" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel_thumbnails_left"
    },
    {
      "type": "select",
      "id": "mobile_media_size",
      "label": "Mobile gallery size",
      "options": [
        { "value": "expanded", "label": "Expanded (full bleed)" },
        { "value": "contained", "label": "Contained" }
      ],
      "default": "expanded"
    },
    {
      "type": "select",
      "id": "mobile_carousel_control",
      "label": "Mobile carousel control",
      "options": [
        { "value": "dots", "label": "Dots" },
        { "value": "floating_dots", "label": "Floating dots" },
        { "value": "thumbnails", "label": "Thumbnails" },
        { "value": "free_scroll", "label": "Free scroll" }
      ],
      "default": "floating_dots"
    },
    { "type": "checkbox", "id": "enable_image_zoom", "label": "Enable image zoom", "default": true },
    { "type": "range", "id": "max_image_zoom_level", "label": "Max zoom level", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "enable_video_autoplay", "label": "Autoplay videos", "default": false },
    { "type": "checkbox", "id": "enable_video_looping", "label": "Loop videos", "default": false },
    { "type": "header", "content": "Add to cart button" },
    {
      "type": "select",
      "id": "cta_shape",
      "label": "Button shape",
      "info": "Pill matches the header CTA and the rest of the site.",
      "options": [
        { "value": "pill", "label": "Pill" },
        { "value": "squared", "label": "Squared (4px)" }
      ],
      "default": "pill"
    },
    {
      "type": "select",
      "id": "after_add_to_cart",
      "label": "After add to cart",
      "info": "Drawer keeps the buyer on the page and opens the cart drawer — this is the setting we run in production.",
      "options": [
        { "value": "drawer", "label": "Open cart drawer (recommended)" },
        { "value": "cart_page", "label": "Go to the cart page" },
        { "value": "checkout", "label": "Skip cart → checkout" }
      ],
      "default": "drawer"
    },
    { "type": "header", "content": "Reviews" },
    { "type": "checkbox", "id": "enable_judgeme", "label": "Show Judge.me stars under title", "info": "Turn on AFTER installing the Judge.me app, or the page will error.", "default": false },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#FAF5F0" },
    { "type": "color", "id": "section_text_color", "label": "Section text color", "default": "#1F1A1C" },
    { "type": "color", "id": "accent_color", "label": "Accent (pink)", "default": "#C4718E" },
    { "type": "color", "id": "accent_deep", "label": "Accent deep (plum)", "default": "#7A3A54" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Eyebrow text", "info": "Falls back to product metafield rosalia.eyebrow" }
      ]
    },
    { "type": "title", "name": "Title", "limit": 1, "settings": [] },
    {
      "type": "subtitle",
      "name": "Subtitle",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "text", "label": "Subtitle text", "info": "Falls back to product metafield rosalia.subtitle" }
      ]
    },
    {
      "type": "tag_pills",
      "name": "Tag pills",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Reads from product metafield rosalia.tag_pills (list of text)." }
      ]
    },
    {
      "type": "benefits",
      "name": "Benefits list",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Reads from product metafield rosalia.benefits (JSON list of HTML strings)." },
        { "type": "textarea", "id": "icon_svg", "label": "Icon SVG (optional)", "info": "Paste an inline SVG string, or leave blank for default check icon. Applied to every benefit row." }
      ]
    },
    {
      "type": "symptom_picker",
      "name": "Symptom picker",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "What is your skin doing?" },
        { "type": "textarea", "id": "hint", "label": "Hint line", "default": "Tap the one you know best — see what's actually happening underneath, and what stops it." },
        { "type": "text", "id": "link_text", "label": "Link text" },
        { "type": "url", "id": "link_url", "label": "Link URL" },
        { "type": "paragraph", "content": "Reads from product metafield rosalia.symptoms (list of Symptom metaobjects)." }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker (Impact)",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Impact's default variant picker. Use this OR bundle_tiers, not both." },
        { "type": "select", "id": "picker_type", "label": "Type", "options": [{"value":"dropdown","label":"Dropdown"},{"value":"button","label":"Button"}], "default": "button" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Button label", "default": "GET MY FACE BACK" }
      ]
    },
    {
      "type": "ship_indicators",
      "name": "Ship indicators",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text_1", "label": "Indicator 1", "default": "Free shipping over $50" },
        { "type": "text", "id": "text_2", "label": "Indicator 2", "default": "Ships in 48h" },
        { "type": "text", "id": "text_3", "label": "Indicator 3" }
      ]
    },
    {
      "type": "guarantee",
      "name": "Guarantee card",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "headline", "label": "Headline", "default": "60-day reset guarantee" },
        { "type": "richtext", "id": "text", "label": "Guarantee copy", "default": "<p>Try Rosalia for 60 days. Full refund if it's not right — no forms, no return shipping.</p>" }
      ]
    },
    {
      "type": "more_answers",
      "name": "Looking for more answers?",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Looking for more answers?" },
        { "type": "text", "id": "input_placeholder", "label": "Input placeholder", "default": "Have questions? Ask here" },
        { "type": "url", "id": "input_url", "label": "Input destination", "info": "The field is not a live search — clicking it sends the visitor here. Defaults to /pages/contact." },
        { "type": "header", "content": "Quick question 1" },
        { "type": "text", "id": "q1_label", "label": "Question" },
        { "type": "richtext", "id": "q1_answer", "label": "Answer" },
        { "type": "header", "content": "Quick question 2" },
        { "type": "text", "id": "q2_label", "label": "Question" },
        { "type": "richtext", "id": "q2_answer", "label": "Answer" },
        { "type": "header", "content": "Quick question 3" },
        { "type": "text", "id": "q3_label", "label": "Question" },
        { "type": "richtext", "id": "q3_answer", "label": "Answer" }
      ]
    },
    {
      "type": "delivery_estimate",
      "name": "Delivery estimate",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "min_days", "label": "Fastest (business days)", "min": 1, "max": 10, "step": 1, "default": 4 },
        { "type": "range", "id": "max_days", "label": "Slowest (business days)", "min": 2, "max": 21, "step": 1, "default": 8 },
        { "type": "paragraph", "content": "Business days — weekends are skipped automatically. Keep them matched to your real carrier times." }
      ]
    },
    {
      "type": "trust_badges",
      "name": "Trust badge row",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "trust_badge_1", "label": "Badge 1", "default": "60-day guarantee" },
        { "type": "text", "id": "trust_badge_2", "label": "Badge 2", "default": "Free shipping $50+" },
        { "type": "text", "id": "trust_badge_3", "label": "Badge 3", "default": "Ships in 48h" },
        { "type": "text", "id": "trust_badge_4", "label": "Badge 4", "default": "Secure checkout" }
      ]
    },
    {
      "type": "app_zone",
      "name": "App block zone",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "label", "label": "Zone label (optional)", "info": "Shown in the theme editor to help you find the zone." },
        { "type": "paragraph", "content": "Drop @app blocks (Catching Bundle, Rebuy, etc.) directly above or below this block. Alternatively, add a Custom Liquid block and paste your app's snippet." }
      ]
    },
    {
      "type": "richtext",
      "name": "Rich text",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Free text block — add anything here.</p>" }
      ]
    },
    {
      "type": "liquid",
      "name": "Custom Liquid",
      "settings": [
        { "type": "liquid", "id": "custom_liquid", "label": "Liquid code" }
      ]
    }
