{%- comment -%}
  ══════════════════════════════════════════════════════════════════════
  Rosalia · Funnel — Editorial block
  ══════════════════════════════════════════════════════════════════════
  The workhorse. One "step" of the advertorial slide, or one "reason" of a
  listicle, or one section of a prelander.

  Everything that appears INSIDE the prose flow is a block here, not a
  separate section — deliberately. In the advertorial the voice quotes and
  the science notes sit inside a step; promoting them to sections would
  insert a seam and close the thought, which the slippery-slide geometry
  forbids. Blocks keep the descent unbroken while staying reorderable.

  Block types:
    paragraph · weight · said · pull · voice · note
    image · diagram · inci · bonus · kick · liquid
{%- endcomment -%}

{%- render 'rosalia-funnel-assets' -%}

{%- liquid
  assign s = section.settings
  assign anchor = s.anchor_id | handleize
  assign wide = ''
  if s.container == 'wide'
    assign wide = ' rf-w--wide'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ s.background | default: '#FAF5F0' }};
    color: {{ s.text_color | default: '#2B2620' }};
    padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;
  }
  {%- if s.top_rule %}
  #shopify-section-{{ section.id }} .rf-w { border-top: 1px solid var(--rf-rule); padding-top: {{ s.padding_top }}px; }
  {%- endif %}
</style>

<div class="rf"{% if anchor != blank %} id="{{ anchor }}"{% endif %}>
  <div class="rf-w{{ wide }}">

    {%- if s.rnum != blank -%}
      <p class="rf-rnum" aria-hidden="true">{{ s.rnum }}</p>
    {%- endif -%}

    {%- if s.eyebrow != blank -%}
      <p class="rf-eyebrow">{{ s.eyebrow }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      {%- comment -%} Merchant-authored; <em> is intentional here. {%- endcomment -%}
      <h2 class="rf-h2">{{ s.heading }}</h2>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <div {{ block.shopify_attributes }}>
      {%- case block.type -%}

        {%- when 'paragraph' -%}
          {%- if b.content != blank -%}
            <div class="rf-prose{% if b.is_lead %} rf-lead{% endif %}">{{ b.content }}</div>
          {%- endif -%}

        {%- when 'weight' -%}
          {%- if b.text != blank -%}
            <p class="rf-weight{% if b.accent %} rf-weight--accent{% endif %}">{{ b.text }}</p>
          {%- endif -%}

        {%- when 'said' -%}
          {%- assign lines = b.lines | newline_to_br | split: '<br />' -%}
          {%- if b.lines != blank -%}
            <ul class="rf-said">
              {%- for line in lines -%}
                {%- assign trimmed = line | strip -%}
                {%- if trimmed != blank -%}<li>{{ trimmed }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

        {%- when 'pull' -%}
          {%- if b.content != blank -%}
            <div class="rf-pull">{{ b.content }}</div>
          {%- endif -%}

        {%- when 'voice' -%}
          {%- if b.quote != blank -%}
            <blockquote class="rf-voice{% if b.emphasis %} rf-voice--plus{% endif %}">
              <p>{{ b.quote }}</p>
              {%- if b.attribution != blank -%}
                <p class="rf-who">{{ b.attribution }}</p>
              {%- endif -%}
            </blockquote>
          {%- endif -%}

        {%- when 'note' -%}
          {%- if b.content != blank -%}
            <aside class="rf-note">
              <div class="rf-prose">{{ b.content }}</div>
              {%- if b.source != blank -%}
                <p class="rf-src">{{ b.source }}</p>
              {%- endif -%}
            </aside>
          {%- endif -%}

        {%- when 'image' -%}
          <figure class="rf-figure">
            {%- if b.image != blank -%}
              {{ b.image
                 | image_url: width: 1200
                 | image_tag:
                     widths: '400, 600, 800, 1000, 1200',
                     sizes: '(min-width: 700px) 680px, 100vw',
                     loading: b.loading,
                     alt: b.alt }}
            {%- else -%}
              <div class="rf-slot" role="img" aria-label="{{ b.alt | default: 'Image placeholder' | escape }}">
                <span>{{ b.placeholder_note | default: 'Image slot — fill from the section settings.' }}</span>
              </div>
            {%- endif -%}
            {%- if b.caption != blank -%}
              <figcaption class="rf-figcap">{{ b.caption }}</figcaption>
            {%- endif -%}
          </figure>

        {%- when 'diagram' -%}
          <div class="rf-dgm{% if b.narrow %} rf-dgm--narrow{% endif %}">
            {%- case b.which -%}
              {%- when 'collapse' -%}
                {%- render 'rosalia-svg-collapse-chart', label: b.aria_label -%}
              {%- when 'mechanism' -%}
                {%- render 'rosalia-svg-mechanism-3jobs', label: b.aria_label -%}
              {%- when 'loop' -%}
                {%- render 'rosalia-svg-loop-5points', label: b.aria_label -%}
              {%- when 'stores' -%}
                {%- render 'rosalia-svg-stores-4', label: b.aria_label -%}
            {%- endcase -%}
            {%- if b.legend != blank -%}
              <p class="rf-leg">{{ b.legend }}</p>
            {%- endif -%}
          </div>
          {%- if b.caption != blank -%}
            <p class="rf-cap">{{ b.caption }}</p>
          {%- endif -%}

        {%- when 'inci' -%}
          {%- if b.content != blank -%}
            <p class="rf-inci">{{ b.content }}</p>
          {%- endif -%}
          {%- if b.free_from != blank -%}
            <p class="rf-small" style="margin-top:16px;">{{ b.free_from }}</p>
          {%- endif -%}

        {%- when 'bonus' -%}
          <div class="rf-bonus">
            {%- if b.eyebrow != blank -%}<p class="rf-eyebrow">{{ b.eyebrow }}</p>{%- endif -%}
            {%- if b.content != blank -%}<div class="rf-prose">{{ b.content }}</div>{%- endif -%}
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 1000 | image_tag:
                   widths: '400, 600, 800, 1000',
                   sizes: '(min-width: 700px) 640px, 100vw',
                   loading: 'lazy',
                   alt: b.alt,
                   class: 'rf-bonus-img' }}
            {%- elsif b.placeholder_note != blank -%}
              <div class="rf-slot" style="margin-top:14px;" role="img" aria-label="{{ b.alt | default: 'Image placeholder' | escape }}">
                <span>{{ b.placeholder_note }}</span>
              </div>
            {%- endif -%}
          </div>

        {%- when 'kick' -%}
          {%- if b.text != blank -%}
            <p class="rf-kick">{{ b.text }}</p>
          {%- endif -%}

        {%- when 'small' -%}
          {%- if b.text != blank -%}
            <p class="rf-small">{{ b.text }}</p>
          {%- endif -%}

        {%- when 'button' -%}
          {%- if b.label != blank -%}
            <a class="{% if b.style == 'quiet' %}rf-btn-quiet{% else %}rf-btn rf-btn--block{% endif %}"
               href="{{ b.url | default: routes.root_url }}">{{ b.label }}</a>
          {%- endif -%}

        {%- when 'pairs' -%}
          {%- comment -%}
            A two-column definition row: label on the left, its counterpart
            right-aligned. Used for "what each treatment actually touched"
            and for the actives-with-percentages list.
            Authored as "left | right", one per line.
          {%- endcomment -%}
          {%- if b.rows != blank -%}
            {%- assign pair_rows = b.rows | newline_to_br | split: '<br />' -%}
            <ul class="rf-pairs rf-pairs--{{ b.variant }}">
              {%- for row in pair_rows -%}
                {%- comment -%}
                  Split on the FIRST pipe only, so a pipe inside the right-hand
                  copy cannot silently truncate the row.
                {%- endcomment -%}
                {%- assign parts = row | split: '|' -%}
                {%- assign left = parts[0] | strip -%}
                {%- assign right = '' -%}
                {%- if parts.size > 1 -%}
                  {%- assign right = row | remove_first: parts[0] | remove_first: '|' | strip -%}
                {%- endif -%}
                {%- if left != blank -%}
                  <li>
                    <span>{{ left }}</span>
                    {%- if right != blank -%}
                      <span class="rf-pair-r">{{ right }}</span>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

        {%- when 'tags' -%}
          {%- assign tag_list = b.tags | split: ',' -%}
          {%- if b.tags != blank -%}
            <div class="rf-tags">
              {%- for t in tag_list -%}
                {%- assign tt = t | strip -%}
                {%- if tt != blank -%}<span>{{ tt }}</span>{%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

        {%- when 'more' -%}
          <div class="rf-more">
            {%- if b.heading != blank -%}<h4>{{ b.heading }}</h4>{%- endif -%}
            <ul>
              {%- for i in (1..3) -%}
                {%- assign t_key = 'title_' | append: i -%}
                {%- assign u_key = 'url_' | append: i -%}
                {%- assign c_key = 'cat_' | append: i -%}
                {%- assign title = b[t_key] -%}
                {%- if title != blank -%}
                  <li>
                    {%- if b[c_key] != blank -%}<span class="rf-cat">{{ b[c_key] }}</span>{%- endif -%}
                    <a href="{{ b[u_key] | default: '#' }}">{{ title }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>

        {%- when 'liquid' -%}
          {{ b.custom_liquid }}

      {%- endcase -%}
      </div>
    {%- endfor -%}

  </div>
</div>

{% schema %}
{
  "name": "Rosalia — Funnel block",
  "class": "shopify-section--rosalia-funnel",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "rnum", "label": "Reason number", "info": "Listicles only. Leave blank on the advertorial and prelanders." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (H2)", "info": "Inline <em> is allowed and renders italic in the accent colour." },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Optional. Lets you link to this block with /page#your-id." },

    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "container", "label": "Column width", "default": "measure",
      "options": [
        { "value": "measure", "label": "Editorial column (680px)" },
        { "value": "wide", "label": "Wide (960px)" }
      ]
    },
    { "type": "checkbox", "id": "top_rule", "label": "Hairline above this block", "default": false, "info": "Leave OFF inside the advertorial — the slide has no separators." },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FAF5F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2B2620" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "paragraph", "name": "Paragraph",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Text" },
        { "type": "checkbox", "id": "is_lead", "label": "Lead paragraph (larger)", "default": false }
      ]
    },
    {
      "type": "weight", "name": "Weight line",
      "settings": [
        { "type": "text", "id": "text", "label": "Line", "info": "The punctuation of the slide. Inline <em> allowed." },
        { "type": "checkbox", "id": "accent", "label": "Accent colour", "default": false }
      ]
    },
    {
      "type": "said", "name": "Quoted lines",
      "settings": [
        { "type": "textarea", "id": "lines", "label": "Lines", "info": "One quote per line." }
      ]
    },
    {
      "type": "pull", "name": "Pull quote",
      "settings": [ { "type": "richtext", "id": "content", "label": "Quote" } ]
    },
    {
      "type": "voice", "name": "Voice (real post)",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "info": "Verbatim from a real public post. Never write one." },
        { "type": "text", "id": "attribution", "label": "Attribution", "info": "e.g. Reddit · 18 months postpartum" },
        { "type": "checkbox", "id": "emphasis", "label": "Emphasised (accent edge)", "default": false }
      ]
    },
    {
      "type": "note", "name": "Science note",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Text" },
        { "type": "text", "id": "source", "label": "Source line" }
      ]
    },
    {
      "type": "image", "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text", "info": "Describe the picture for screen readers." },
        { "type": "textarea", "id": "placeholder_note", "label": "Brief (shown until the image is added)", "info": "The art-direction note for whoever shoots or generates this asset." },
        { "type": "richtext", "id": "caption", "label": "Caption" },
        {
          "type": "select", "id": "loading", "label": "Loading", "default": "lazy",
          "options": [
            { "value": "lazy", "label": "Lazy (default)" },
            { "value": "eager", "label": "Eager — hero image only" }
          ]
        }
      ]
    },
    {
      "type": "diagram", "name": "Diagram",
      "settings": [
        {
          "type": "select", "id": "which", "label": "Which diagram", "default": "collapse",
          "options": [
            { "value": "collapse", "label": "Endocrine collapse (advertorial)" },
            { "value": "mechanism", "label": "Three jobs / mechanism (advertorial)" },
            { "value": "loop", "label": "Five-point loop (flusher)" },
            { "value": "stores", "label": "Four depleted stores (postpartum)" }
          ]
        },
        { "type": "text", "id": "aria_label", "label": "Description for screen readers" },
        { "type": "checkbox", "id": "narrow", "label": "Narrow (360px max)", "default": false },
        { "type": "richtext", "id": "legend", "label": "Legend (inside the frame)" },
        { "type": "richtext", "id": "caption", "label": "Caption (below the frame)" }
      ]
    },
    {
      "type": "inci", "name": "Ingredient list",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Actives", "info": "The formula is six actives. Do not add a seventh, and there is no hyaluronic acid in it." },
        { "type": "text", "id": "free_from", "label": "Free-from line" }
      ]
    },
    {
      "type": "bonus", "name": "Bonus card",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "richtext", "id": "content", "label": "Text" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "textarea", "id": "placeholder_note", "label": "Brief (shown until the image is added)" }
      ]
    },
    {
      "type": "kick", "name": "Kicker (curiosity gap)",
      "settings": [ { "type": "text", "id": "text", "label": "Line", "info": "The hook that carries the reader into the next block." } ]
    },
    {
      "type": "small", "name": "Small print",
      "settings": [ { "type": "text", "id": "text", "label": "Text" } ]
    },
    {
      "type": "button", "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "url", "label": "Link" },
        {
          "type": "select", "id": "style", "label": "Style", "default": "primary",
          "options": [
            { "value": "primary", "label": "Primary — full width" },
            { "value": "quiet", "label": "Quiet — underlined link" }
          ]
        }
      ]
    },
    {
      "type": "pairs", "name": "Two-column list",
      "settings": [
        { "type": "textarea", "id": "rows", "label": "Rows", "info": "One per line, written as: left | right" },
        {
          "type": "select", "id": "variant", "label": "Right column style", "default": "label",
          "options": [
            { "value": "label", "label": "Small caps label, right-aligned" },
            { "value": "figure", "label": "Serif figure (percentages)" },
            { "value": "stage", "label": "Stage — label on the left, copy on the right" }
          ]
        }
      ]
    },
    {
      "type": "tags", "name": "Topic tags",
      "settings": [ { "type": "text", "id": "tags", "label": "Tags", "info": "Comma separated." } ]
    },
    {
      "type": "more", "name": "More from…",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "More from Research" },
        { "type": "text", "id": "cat_1", "label": "1 — category" },
        { "type": "text", "id": "title_1", "label": "1 — title" },
        { "type": "url", "id": "url_1", "label": "1 — link" },
        { "type": "text", "id": "cat_2", "label": "2 — category" },
        { "type": "text", "id": "title_2", "label": "2 — title" },
        { "type": "url", "id": "url_2", "label": "2 — link" },
        { "type": "text", "id": "cat_3", "label": "3 — category" },
        { "type": "text", "id": "title_3", "label": "3 — title" },
        { "type": "url", "id": "url_3", "label": "3 — link" }
      ]
    },
    {
      "type": "liquid", "name": "Custom Liquid",
      "settings": [ { "type": "liquid", "id": "custom_liquid", "label": "Liquid" } ]
    }
  ],
  "presets": [
    {
      "name": "Rosalia — Funnel block",
      "blocks": [ { "type": "paragraph" } ]
    },
    {
      "name": "Rosalia — Listicle reason",
      "settings": { "rnum": "01", "top_rule": true },
      "blocks": [ { "type": "paragraph" }, { "type": "kick" } ]
    }
  ]
}
{% endschema %}
