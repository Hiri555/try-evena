<script>
  (function(){
    var bar = document.querySelector('[data-tdb-bar]');
    if(bar){
      var raf = null;
      function update(){
        var h = document.documentElement;
        var height = h.scrollHeight - h.clientHeight;
        bar.style.width = (height > 0 ? (h.scrollTop / height) * 100 : 0).toFixed(2) + '%';
        raf = null;
      }
      window.addEventListener('scroll', function(){ if(raf === null) raf = requestAnimationFrame(update); }, { passive:true });
      update();
    }

    /* The poll returns what the pattern MEANS. It deliberately returns no
       percentages: we have no reader survey, and inventing one to make the
       widget feel populated would be fabricating data. The mechanism is
       the useful half and it is the half we can stand behind. */
    var responses = {
      'which-flush': {
        'warm':      { head: 'A room-triggered flush', text: 'This is the pattern that points at the heat threshold itself. The receptor is answering the ambient temperature of the room rather than any specific thing you ate, drank or said — which is why trigger lists never quite cover it.' },
        'seen':      { head: 'A socially triggered flush', text: 'This one runs through the stress response rather than through heat. It is the pattern most often underestimated, because there is no physical trigger to point at and nothing on a trigger list to remove.' },
        'delayed':   { head: 'A flush that arrives late', text: 'A delayed flush is the signature of a reset that is not arriving on time — the vessel is being held open after the trigger has gone. This is the pattern the enzyme section of our mechanism piece is about.' },
        'notrigger': { head: 'A flush with no trigger', text: 'When the flush stops waiting for a reason, the architecture itself has usually become reactive: more vessels, wider, slower to close. This is typically the last pattern to appear, and the one avoidance helps least.' }
      },
      'four-rooms': {
        'meeting':   { head: 'The meeting room', text: 'It stacks the strongest ambient inputs at once: shared body heat, a radiator, and being looked at. It is the room most often named in the National Rosacea Society workplace survey cited above.' },
        'video':     { head: 'The video call', text: 'The newest of these rooms and the least diagnosed. Self-view is the multiplier — it adds a feedback loop a normal conversation does not have. Hiding it removes a measurable part of the loop.' },
        'front':     { head: 'The front desk', text: 'A client-facing counter combines overhead heat with continuous visual exposure over a whole shift. The flush tends to arrive on shift rather than in any one interaction.' },
        'interview': { head: 'The interview', text: 'The sharpest stress input of the four, and the one that most often arrives before the first question is asked — which is the clearest sign the trigger is adrenergic rather than thermal.' }
      }
    };

    document.querySelectorAll('.tdb .poll').forEach(function(poll){
      var type = poll.getAttribute('data-poll');
      var options = poll.querySelector('.poll__options');
      var note = poll.querySelector('.poll__note');
      var result = poll.querySelector('.poll__result');
      var stat = poll.querySelector('.poll__result-stat');
      var text = poll.querySelector('.poll__result-text');
      poll.querySelectorAll('.poll__options button').forEach(function(btn){
        btn.addEventListener('click', function(){
          var data = responses[type] && responses[type][btn.getAttribute('data-answer')];
          if(!data) return;
          stat.textContent = data.head;
          text.textContent = data.text;
          options.style.display = 'none';
          if(note) note.style.display = 'none';
          result.hidden = false;
        });
      });
    });
  })();
</script>

