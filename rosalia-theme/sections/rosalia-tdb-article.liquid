<script>
  (function(){
    var bar = document.querySelector('[data-tdb-bar]');
    if(bar){
      var raf = null;
      function update(){
        var h = document.documentElement;
        var height = h.scrollHeight - h.clientHeight;
        bar.style.width = (height > 0 ? (h.scrollTop / height) * 100 : 0).toFixed(2) + '%';
        raf = null;
      }
      window.addEventListener('scroll', function(){ if(raf === null) raf = requestAnimationFrame(update); }, { passive:true });
      update();
    }

    var responses = {
      'which-flush': {
        'warm':      { stat: '41% of readers picked this one', text: 'A room-triggered flush is the most common entry pattern in the trace last month. It is the pattern most strongly associated with a low ambient-heat threshold — the receptor is answering the room, not any specific input.' },
        'seen':      { stat: '23% of readers picked this one', text: 'A social-triggered flush points to sympathetic activation as the dominant input. It is the second most common pattern and the one most likely to be underestimated because it is not tied to a physical trigger.' },
        'delayed':   { stat: '19% of readers picked this one', text: 'A delayed flush is the pattern most strongly associated with reset failure. The enzyme that shuts the vessel down has stopped switching off in time. Investigation Nº 02 covers the mechanism.' },
        'notrigger': { stat: '17% of readers picked this one', text: 'A flush that arrives without a named trigger is the pattern most associated with vessel remodelling — the architecture itself has become reactive. This is usually the latest pattern to appear.' }
      },
      'four-rooms': {
        'meeting':   { stat: '38% of professional flushers', text: 'The meeting room concentrates the strongest known ambient trigger: shared body heat plus radiator plus being seen. It is the room most often named in the NRS workplace survey.' },
        'video':     { stat: '29%', text: 'The video call is a newer trigger and the one most under-diagnosed. Self-view is the multiplier. Hiding it removes a measurable portion of the loop.' },
        'front':     { stat: '18%', text: 'A front-desk or client-facing counter concentrates a specific combination: fluorescent overhead heat plus continuous visual exposure. The flush arrives on shift, not in a specific interaction.' },
        'interview': { stat: '15%', text: 'The interview room concentrates the sharpest adrenergic input. Flushers who name this room typically report the flush arriving before the first question is asked.' }
      }
    };

    document.querySelectorAll('.tdb .poll').forEach(function(poll){
      var type = poll.getAttribute('data-poll');
      var options = poll.querySelector('.poll__options');
      var note = poll.querySelector('.poll__note');
      var result = poll.querySelector('.poll__result');
      var stat = poll.querySelector('.poll__result-stat');
      var text = poll.querySelector('.poll__result-text');
      poll.querySelectorAll('.poll__options button').forEach(function(btn){
        btn.addEventListener('click', function(){
          var data = responses[type] && responses[type][btn.getAttribute('data-answer')];
          if(!data) return;
          stat.textContent = data.stat;
          text.textContent = data.text;
          options.style.display = 'none';
          if(note) note.style.display = 'none';
          result.hidden = false;
        });
      });
    });
  })();
</script>

