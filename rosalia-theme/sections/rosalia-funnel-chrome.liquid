{%- comment -%}
  Rosalia · Funnel — Publication chrome
  Trust bar + masthead + section nav + breadcrumb.
  Used by the prelanders and the listicles. The advertorial has no chrome
  by design — it is a slide, and a nav is an exit.
{%- endcomment -%}

{%- render 'rosalia-funnel-assets' -%}

{%- liquid
  assign s = section.settings
  assign trust_items = section.blocks | where: 'type', 'trust'
  assign nav_items = section.blocks | where: 'type', 'nav'
  assign sub_items = section.blocks | where: 'type', 'subnav'
-%}

<div class="rf">

  {%- if s.show_trust and trust_items.size > 0 -%}
    <div class="rf-trust">
      <div class="rf-w rf-w--wide">
        {%- for block in trust_items -%}
          <span class="rf-trust-item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}<path d="M12 2.5 4 5v6c0 4.5 3.4 8.2 8 9.5 4.6-1.3 8-5 8-9.5V5Z"/><path d="M8.5 12 11 14.5 15.5 9.5"/>
                  {%- when 'leaf' -%}<path d="M4.5 19.5C4.5 11.5 10 4 20 4c0 10-6 15.5-15.5 15.5Z"/><path d="M4.5 19.5C8 16 12 12.5 17 9"/>
                  {%- when 'flask' -%}<path d="M9 3h6"/><path d="M10 3v7l-4 7.5A2 2 0 0 0 7.8 21h8.4a2 2 0 0 0 1.8-3.5L14 10V3"/><path d="M7.5 15h9"/>
                  {%- when 'check' -%}<path d="M4 12.5 9 17.5 20 6.5"/>
                {%- endcase -%}
              </svg>
            {%- endif -%}
            <span>{{ block.settings.text }}</span>
          </span>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if s.show_masthead -%}
    <header class="rf-masthead">
      <div class="rf-w rf-w--wide">
        <a class="rf-brand" href="{{ s.brand_url | default: routes.root_url }}">
          {{ s.brand_name }}{% if s.brand_accent != blank %}<span>{{ s.brand_accent }}</span>{% endif %}
        </a>
        {%- if nav_items.size > 0 -%}
          <nav class="rf-nav" aria-label="{{ s.nav_label | default: 'Sections' | escape }}">
            {%- for block in nav_items -%}
              <a href="{{ block.settings.url | default: '#' }}"
                 {% if block.settings.current %}aria-current="true"{% endif %}
                 {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
            {%- endfor -%}
          </nav>
        {%- endif -%}
      </div>
    </header>
  {%- endif -%}

  {%- if sub_items.size > 0 -%}
    <nav class="rf-subnav" aria-label="{{ s.subnav_label | default: 'Topics' | escape }}">
      <div class="rf-w rf-w--wide">
        {%- for block in sub_items -%}
          <a href="{{ block.settings.url | default: '#' }}"
             {% if block.settings.current %}aria-current="true"{% endif %}
             {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
        {%- endfor -%}
      </div>
    </nav>
  {%- endif -%}

  {%- if s.breadcrumb != blank -%}
    <div class="rf-w">
      <p class="rf-crumb">{{ s.breadcrumb }}</p>
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Rosalia — Funnel chrome",
  "class": "shopify-section--rosalia-funnel",
  "settings": [
    { "type": "header", "content": "Trust bar" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust bar", "default": true },

    { "type": "header", "content": "Masthead" },
    { "type": "checkbox", "id": "show_masthead", "label": "Show masthead", "default": true },
    { "type": "text", "id": "brand_name", "label": "Publication name", "default": "The Skin" },
    { "type": "text", "id": "brand_accent", "label": "Accent half", "default": " File", "info": "Rendered in the accent colour, straight after the name." },
    { "type": "url", "id": "brand_url", "label": "Masthead link" },
    { "type": "text", "id": "nav_label", "label": "Nav ARIA label", "default": "Sections" },
    { "type": "text", "id": "subnav_label", "label": "Sub-nav ARIA label", "default": "Topics" },

    { "type": "header", "content": "Breadcrumb" },
    { "type": "richtext", "id": "breadcrumb", "label": "Breadcrumb", "info": "Use <b> for the current topic." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "trust", "name": "Trust item", "limit": 5,
      "settings": [
        { "type": "text", "id": "text", "label": "Text" },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "check",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "check", "label": "Check" },
            { "value": "shield", "label": "Shield" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "flask", "label": "Flask" }
          ]
        }
      ]
    },
    {
      "type": "nav", "name": "Nav link", "limit": 8,
      "settings": [
        { "type": "text", "id": "text", "label": "Label" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "checkbox", "id": "current", "label": "Mark as current", "default": false }
      ]
    },
    {
      "type": "subnav", "name": "Sub-nav link", "limit": 12,
      "settings": [
        { "type": "text", "id": "text", "label": "Label" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "checkbox", "id": "current", "label": "Mark as current", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rosalia — Funnel chrome",
      "blocks": [
        { "type": "trust", "settings": { "text": "60-day money-back guarantee", "icon": "shield" } },
        { "type": "trust", "settings": { "text": "Formulated with a vascular biologist", "icon": "flask" } },
        { "type": "trust", "settings": { "text": "Cruelty-free · vegan", "icon": "leaf" } }
      ]
    }
  ]
}
{% endschema %}
