{%- render 'rosalia-tokens' -%}
{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background | default: 'var(--rosalia-cream)' }};
    color: {{ section.settings.text_color | default: 'var(--rosalia-dark)' }};
    padding-block: {{ section.settings.padding_top | default: 100 }}px {{ section.settings.padding_bottom | default: 100 }}px;
  }
  #shopify-section-{{ section.id }} .rosalia-tl-inner {
    max-width: {{ section.settings.max_width | default: 1200 }}px;
    margin: 0 auto;
    padding-inline: 48px;
  }
  #shopify-section-{{ section.id }} .rosalia-mechanism-eyebrow {
    font-family: var(--rosalia-font-sans); font-size: 10px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--rosalia-pink); font-weight: 500; margin-bottom: 14px;
  }
  #shopify-section-{{ section.id }} .rosalia-mechanism-heading {
    font-family: var(--rosalia-font-serif); font-size: clamp(28px, 3.5vw, 38px); font-weight: 500;
    line-height: 1.1; letter-spacing: -0.015em; margin-bottom: 14px;
  }
  #shopify-section-{{ section.id }} .rosalia-mechanism-heading em { font-style: italic; color: var(--rosalia-plum); }
  #shopify-section-{{ section.id }} .rosalia-mechanism-lead {
    font-family: var(--rosalia-font-serif); font-style: italic; font-size: 17px;
    color: var(--rosalia-gray); line-height: 1.5; max-width: 540px; margin-bottom: 48px;
  }

  #shopify-section-{{ section.id }} .rosalia-tl-track { display:flex; gap:0; overflow-x:auto; scrollbar-width:none; -webkit-overflow-scrolling:touch; }
  #shopify-section-{{ section.id }} .rosalia-tl-track::-webkit-scrollbar { display:none; }
  #shopify-section-{{ section.id }} .rosalia-tl-step { flex:0 0 25%; min-width:220px; text-align:center; padding:0 20px; position:relative; }
  #shopify-section-{{ section.id }} .rosalia-tl-step::before {
    content:''; position:absolute; top:32px; left:0; right:0; height:2px; background:var(--rosalia-pink-light);
  }
  #shopify-section-{{ section.id }} .rosalia-tl-step:first-child::before { left:50%; }
  #shopify-section-{{ section.id }} .rosalia-tl-step:last-child::before { right:50%; }
  #shopify-section-{{ section.id }} .rosalia-tl-dot {
    width:16px; height:16px; border-radius:50%; background:var(--rosalia-cream); border:2px solid var(--rosalia-pink);
    margin:24px auto 18px; position:relative; z-index:1; transition:all .3s var(--rosalia-ease);
    display:flex; align-items:center; justify-content:center;
  }
  #shopify-section-{{ section.id }} .rosalia-tl-dot img { width:100%; height:100%; object-fit:contain; border-radius:50%; }
  #shopify-section-{{ section.id }} .rosalia-tl-step:hover .rosalia-tl-dot { background:var(--rosalia-pink); transform:scale(1.3); }
  #shopify-section-{{ section.id }} .rosalia-tl-week { font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:var(--rosalia-pink); font-weight:600; margin-bottom:6px; }
  #shopify-section-{{ section.id }} .rosalia-tl-title { font-family:var(--rosalia-font-serif); font-size:18px; font-weight:600; margin-bottom:6px; line-height:1.2; }
  #shopify-section-{{ section.id }} .rosalia-tl-desc { font-size:12px; color:var(--rosalia-gray); line-height:1.5; }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .rosalia-tl-dot { transition: none; }
    #shopify-section-{{ section.id }} .rosalia-tl-step:hover .rosalia-tl-dot { transform: none; }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .rosalia-tl-inner { padding-inline: 24px; }
    #shopify-section-{{ section.id }} .rosalia-tl-step { min-width:200px; }
  }
</style>

<div {% render 'section-properties', tight: true %}>
  <div class="rosalia-tl-inner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="rosalia-mechanism-eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="rosalia-mechanism-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.lead != blank -%}
      <p class="rosalia-mechanism-lead">{{ section.settings.lead }}</p>
    {%- endif -%}

    <div class="rosalia-tl-track">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'milestone' -%}
            <div class="rosalia-tl-step" {{ block.shopify_attributes }}>
              <div class="rosalia-tl-dot">
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 32 | image_tag: alt: block.settings.title }}
                {%- endif -%}
              </div>
              <div class="rosalia-tl-week">{{ block.settings.period }}</div>
              <div class="rosalia-tl-title">{{ block.settings.title }}</div>
              {%- if block.settings.description != blank -%}
                <div class="rosalia-tl-desc">{{ block.settings.description }}</div>
              {%- endif -%}
            </div>
          {%- when 'richtext' -%}
            <div class="rosalia-tl-step" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>
          {%- when 'liquid' -%}
            <div class="rosalia-tl-step" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- when '@app' -%}
            {%- render block -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rosalia — Timeline",
  "class": "shopify-section--rosalia",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What to expect" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your first <em>eight weeks</em>." },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "So you know what's happening — and when to stop worrying." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 900, "max": 1400, "step": 50, "default": 1200 },
    { "type": "range", "id": "padding_top", "label": "Padding top (px)", "min": 40, "max": 200, "step": 10, "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 40, "max": 200, "step": 10, "default": 100 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FAF5F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1F1A1C" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "milestone",
      "name": "Timeline milestone",
      "settings": [
        { "type": "text", "id": "period", "label": "Period", "default": "Week 1–2" },
        { "type": "text", "id": "title", "label": "Title", "default": "The quiet" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Skin stops stinging. Barrier rebuilds. Nothing dramatic — that's the point." },
        { "type": "image_picker", "id": "icon", "label": "Icon (optional)" }
      ]
    },
    { "type": "richtext", "name": "Rich text", "settings": [ { "type": "richtext", "id": "content", "label": "Content" } ] },
    { "type": "liquid", "name": "Custom Liquid", "settings": [ { "type": "liquid", "id": "custom_liquid", "label": "Liquid code" } ] }
  ],
  "presets": [
    { "name": "Rosalia — Timeline (8 weeks)", "blocks": [
      { "type": "milestone", "settings": { "period": "Week 1–2", "title": "The quiet", "description": "Skin stops stinging. Barrier rebuilds. Nothing dramatic — that's the point." } },
      { "type": "milestone", "settings": { "period": "Week 3–4", "title": "The first shift", "description": "Baseline redness softens. Flushing episodes shorter. Skin feels less reactive." } },
      { "type": "milestone", "settings": { "period": "Week 5–6", "title": "Others notice", "description": "Tone evens out. Foundation decreases. The 3pm flare stays manageable." } },
      { "type": "milestone", "settings": { "period": "Week 7–8", "title": "The new baseline", "description": "Your skin reaches its new normal. The flare cycle shortens dramatically." } }
    ] }
  ]
}
{% endschema %}
