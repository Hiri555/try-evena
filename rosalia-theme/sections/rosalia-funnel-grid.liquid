{%- comment -%}
  ══════════════════════════════════════════════════════════════════════
  Rosalia · Funnel — Card grid
  ══════════════════════════════════════════════════════════════════════
  One section, four shapes. The shape is not decoration — the three
  funnel pages are read by three different people and the same tiled
  grid on all three read as a template, which is exactly what it was.

    "cards"   the original four-up. Kept so nothing already using it
              breaks.
    "swatch"  a spec sheet. Square material photograph, the dose as a
              large figure under it, the ingredient name, one line. For
              the reader who has already bought five products and wants
              to know what is actually in this one.
    "essay"   two or three big photographs, text beside them, sides
              alternating. Fewer things, larger, more air — for the
              reader holding a baby in the other arm.
    "ledger"  a vertical log. Marker, thumbnail, line, hairline rule.
              For the making-of: how long it took and what it took.

  It also still holds two different kinds of content, and that part has
  not changed:

  1. REVIEWS. Add the review app's block and real customer photo reviews
     render above the cards. That is the version with faces, stars and
     first names, and it fills the day there are real ones. Loox is
     already installed on this store and produces exactly this shape.

  2. CARDS. Until then, the same section carries the product in real
     conditions with one true line under each: what is in the bottle,
     how long it takes, what the refund is, what the panel found.

  What it will not hold is the third thing: invented customers. There is
  no field in this schema for a star rating or a person's name, because
  a testimonial from someone who does not exist is a fabricated
  endorsement — illegal to publish in the US market this store sells
  into, and against the editorial-standards page linked from the footer
  of every funnel page. Real reviews come through the app block, which
  can only show reviews somebody actually wrote.
{%- endcomment -%}

{%- render 'rosalia-funnel-assets' -%}

{%- liquid
  assign s = section.settings
  assign cards = section.blocks | where: 'type', 'card'
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign variant = s.variant | default: 'cards'
  assign wide = ''
  if s.container == 'wide'
    assign wide = ' rf-w--wide'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ s.background | default: '#FAF5F0' }};
    color: {{ s.text_color | default: '#2B2620' }};
    padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;
  }
</style>

{%- if cards.size > 0 or app_blocks.size > 0 -%}
  <div class="rf">
    <div class="rf-w{{ wide }}">
      <section class="rf-grid-sec rf-g--{{ variant }}">

        {%- if s.eyebrow != blank -%}<p class="rf-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="rf-h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.intro != blank -%}<div class="rf-prose">{{ s.intro }}</div>{%- endif -%}

        {%- comment -%} Real reviews, when the app has some. {%- endcomment -%}
        {%- if app_blocks.size > 0 -%}
          <div class="rf-grid-app">
            {%- for block in app_blocks -%}
              <div {{ block.shopify_attributes }}>{%- render block -%}</div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if cards.size > 0 -%}

          {%- comment -%} ── LEDGER: a vertical log, not a grid ───────── {%- endcomment -%}
          {%- if variant == 'ledger' -%}
            <ol class="rf-ledger">
              {%- for block in cards -%}
                {%- assign b = block.settings -%}
                <li class="rf-led" {{ block.shopify_attributes }}>
                  <span class="rf-led-mark">{{ b.figure | default: forloop.index }}</span>
                  {%- if b.image != blank -%}
                    <span class="rf-led-img">
                      {{ b.image
                         | image_url: width: 520
                         | image_tag:
                             widths: '180, 260, 380, 520',
                             sizes: '(min-width: 760px) 180px, 30vw',
                             loading: 'lazy',
                             alt: b.alt }}
                    </span>
                  {%- endif -%}
                  <span class="rf-led-txt">
                    {%- if b.label != blank -%}<b class="rf-led-lab">{{ b.label }}</b>{%- endif -%}
                    {%- if b.line != blank -%}<span class="rf-led-line">{{ b.line }}</span>{%- endif -%}
                  </span>
                </li>
              {%- endfor -%}
            </ol>

          {%- comment -%} ── ESSAY: big photographs, alternating ───────── {%- endcomment -%}
          {%- elsif variant == 'essay' -%}
            <div class="rf-essay">
              {%- for block in cards -%}
                {%- assign b = block.settings -%}
                <article class="rf-es {% cycle 'rf-es--l', 'rf-es--r' %}" {{ block.shopify_attributes }}>
                  {%- if b.image != blank -%}
                    <div class="rf-es-img">
                      {{ b.image
                         | image_url: width: 1200
                         | image_tag:
                             widths: '460, 700, 900, 1200',
                             sizes: '(min-width: 760px) 46vw, 92vw',
                             loading: 'lazy',
                             alt: b.alt }}
                    </div>
                  {%- endif -%}
                  <div class="rf-es-txt">
                    {%- if b.figure != blank -%}<p class="rf-es-fig">{{ b.figure }}</p>{%- endif -%}
                    {%- if b.label != blank -%}<p class="rf-es-lab">{{ b.label }}</p>{%- endif -%}
                    {%- if b.line != blank -%}<p class="rf-es-line">{{ b.line }}</p>{%- endif -%}
                  </div>
                </article>
              {%- endfor -%}
            </div>

          {%- comment -%} ── SWATCH: a spec sheet ──────────────────────── {%- endcomment -%}
          {%- elsif variant == 'swatch' -%}
            <ul class="rf-swatch">
              {%- for block in cards -%}
                {%- assign b = block.settings -%}
                <li class="rf-sw" {{ block.shopify_attributes }}>
                  {%- if b.image != blank -%}
                    <div class="rf-sw-img">
                      {{ b.image
                         | image_url: width: 700
                         | image_tag:
                             widths: '240, 360, 520, 700',
                             sizes: '(min-width: 900px) 220px, 44vw',
                             loading: 'lazy',
                             alt: b.alt }}
                    </div>
                  {%- endif -%}
                  {%- if b.figure != blank -%}<p class="rf-sw-fig">{{ b.figure }}</p>{%- endif -%}
                  {%- if b.label != blank -%}<p class="rf-sw-lab">{{ b.label }}</p>{%- endif -%}
                  {%- if b.line != blank -%}<p class="rf-sw-line">{{ b.line }}</p>{%- endif -%}
                </li>
              {%- endfor -%}
            </ul>

          {%- comment -%} ── CARDS: the original four-up ───────────────── {%- endcomment -%}
          {%- else -%}
            <ul class="rf-grid">
              {%- for block in cards -%}
                {%- assign b = block.settings -%}
                <li class="rf-card" {{ block.shopify_attributes }}>
                  {%- if b.image != blank -%}
                    <div class="rf-card-img">
                      {{ b.image
                         | image_url: width: 800
                         | image_tag:
                             widths: '300, 460, 600, 800',
                             sizes: '(min-width: 900px) 260px, (min-width: 560px) 44vw, 88vw',
                             loading: 'lazy',
                             alt: b.alt }}
                    </div>
                  {%- endif -%}
                  {%- if b.line != blank -%}<p class="rf-card-line">{{ b.line }}</p>{%- endif -%}
                  {%- if b.label != blank -%}<p class="rf-card-label">{{ b.label }}</p>{%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

        {%- endif -%}

        {%- if s.footnote != blank -%}
          <div class="rf-grid-note rf-prose">{{ s.footnote }}</div>
        {%- endif -%}

      </section>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Rosalia — Card grid",
  "class": "shopify-section--rosalia-funnel",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Add your review app's block for real photo reviews. The cards below are for the product in real conditions — one true line each. Never a quote from a customer who did not write it." },
    {
      "type": "select", "id": "variant", "label": "Shape", "default": "cards",
      "info": "Pick a different shape per page. Three funnel pages running the identical tiled grid reads as a template, because it is one.",
      "options": [
        { "value": "cards", "label": "Cards — four square tiles" },
        { "value": "swatch", "label": "Spec sheet — material, dose, name" },
        { "value": "essay", "label": "Photo essay — big images, alternating" },
        { "value": "ledger", "label": "Ledger — a vertical log with markers" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "richtext", "id": "footnote", "label": "Footnote" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "container", "label": "Width", "default": "wide",
      "options": [ { "value": "measure", "label": "Article column" }, { "value": "wide", "label": "Wide" } ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 80, "step": 4, "default": 28, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 80, "step": 4, "default": 28, "unit": "px" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FAF5F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2B2620" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "card", "name": "Card", "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square. The product in a real setting — not a person, unless it is a real customer who gave permission." },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "text", "id": "figure", "label": "Figure", "info": "Spec sheet: the dose, exactly as the ingredient list states it. Ledger: the marker. Left empty on the four-up." },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "line", "label": "Line", "info": "Something true and checkable. Not a quote attributed to anybody." }
      ]
    }
  ],
  "presets": [ { "name": "Rosalia — Card grid" } ]
}
{% endschema %}
