{%- comment -%}
  Rosalia · Funnel — Founder close
  The last thing before the signature: the emotional recall, the autonomy
  paragraph, the final CTA, and "Margot · Rosalia".

  Body paragraphs are blocks so the order stays yours.
{%- endcomment -%}

{%- render 'rosalia-funnel-assets' -%}

{%- liquid
  assign s = section.settings
  assign wide = ''
  if s.container == 'wide'
    assign wide = ' rf-w--wide'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ s.background | default: '#FAF5F0' }};
    color: {{ s.text_color | default: '#2B2620' }};
    padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;
  }
</style>

<div class="rf">
  <div class="rf-w{{ wide }}">

    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <div {{ block.shopify_attributes }}>
      {%- case block.type -%}
        {%- when 'paragraph' -%}
          {%- if b.content != blank -%}<div class="rf-prose">{{ b.content }}</div>{%- endif -%}
        {%- when 'weight' -%}
          {%- if b.text != blank -%}
            <p class="rf-weight{% if b.accent %} rf-weight--accent{% endif %}">{{ b.text }}</p>
          {%- endif -%}
        {%- when 'small' -%}
          {%- if b.text != blank -%}<p class="rf-small">{{ b.text }}</p>{%- endif -%}
      {%- endcase -%}
      </div>
    {%- endfor -%}

    {%- if s.button_label != blank -%}
      <a class="rf-btn rf-btn--block" href="{{ s.button_url | default: routes.root_url }}" style="margin-top:26px;">{{ s.button_label }}</a>
    {%- endif -%}

    {%- if s.signature != blank -%}
      <p class="rf-sign">{{ s.signature }}</p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Rosalia — Funnel close",
  "class": "shopify-section--rosalia-funnel",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "Margot · Rosalia" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "container", "label": "Column width", "default": "measure",
      "options": [
        { "value": "measure", "label": "Editorial column (680px)" },
        { "value": "wide", "label": "Wide (960px)" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FAF5F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2B2620" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "paragraph", "name": "Paragraph", "settings": [ { "type": "richtext", "id": "content", "label": "Text" } ] },
    {
      "type": "weight", "name": "Weight line",
      "settings": [
        { "type": "text", "id": "text", "label": "Line" },
        { "type": "checkbox", "id": "accent", "label": "Accent colour", "default": false }
      ]
    },
    { "type": "small", "name": "Small print", "settings": [ { "type": "text", "id": "text", "label": "Text" } ] }
  ],
  "presets": [ { "name": "Rosalia — Funnel close", "blocks": [ { "type": "paragraph" } ] } ]
}
{% endschema %}
