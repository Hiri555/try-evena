{%- render 'rosalia-tokens' -%}
{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .rosalia-comp-outer {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 48px;
  }
  #shopify-section-{{ section.id }} .rosalia-comp-shell {
    background: {{ section.settings.background | default: 'var(--rosalia-wine)' }};
    color: {{ section.settings.text_color | default: 'var(--rosalia-cream)' }};
    border-radius: 20px;
    padding: 64px 48px;
  }
  #shopify-section-{{ section.id }} .rosalia-comp-heading {
    font-family: var(--rosalia-font-serif);
    font-size: clamp(28px, 3.5vw, 38px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-align: center;
    margin-bottom: 10px;
  }
  #shopify-section-{{ section.id }} .rosalia-comp-heading p { margin: 0; }
  #shopify-section-{{ section.id }} .rosalia-comp-heading em {
    font-style: italic;
    color: {{ section.settings.accent | default: 'var(--rosalia-pink-mid)' }};
  }
  #shopify-section-{{ section.id }} .rosalia-comp-lead {
    font-family: var(--rosalia-font-serif);
    font-style: italic;
    font-size: 16px;
    color: {{ section.settings.accent | default: 'var(--rosalia-pink-mid)' }};
    text-align: center;
    margin: 0 auto 44px;
    max-width: 520px;
    line-height: 1.5;
  }
  #shopify-section-{{ section.id }} .rosalia-comp-bottles {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    margin-bottom: 44px;
  }
  #shopify-section-{{ section.id }} .rosalia-comp-bottle { text-align: center; }
  #shopify-section-{{ section.id }} .rosalia-comp-bottle-vis {
    width: 120px; height: 200px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    padding: 12px;
    font-family: var(--rosalia-font-serif);
    font-style: italic;
    font-size: 13px;
    line-height: 1.4;
    white-space: pre-line;
    overflow: hidden;
    margin: 0 auto 14px;
  }
  #shopify-section-{{ section.id }} .rosalia-comp-bottle-vis img { width: 100%; height: 100%; object-fit: cover; border-radius: 8px; }
  #shopify-section-{{ section.id }} .rosalia-comp-bottle--rosalia .rosalia-comp-bottle-vis {
    background: linear-gradient(160deg, var(--rosalia-pink-light), var(--rosalia-pink-mid));
    color: var(--rosalia-wine);
  }
  #shopify-section-{{ section.id }} .rosalia-comp-bottle--other .rosalia-comp-bottle-vis {
    background: linear-gradient(160deg, #C9C3BB, #928C86);
    color: #3A3632;
  }
  #shopify-section-{{ section.id }} .rosalia-comp-bottle-label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0.9;
  }
  #shopify-section-{{ section.id }} .rosalia-comp-vs {
    font-family: var(--rosalia-font-serif);
    font-style: italic;
    font-size: 22px;
    color: {{ section.settings.accent | default: 'var(--rosalia-pink-mid)' }};
  }
  #shopify-section-{{ section.id }} .rosalia-comp-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 6px;
    font-size: 13px;
  }
  #shopify-section-{{ section.id }} .rosalia-comp-table th {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: {{ section.settings.accent | default: 'var(--rosalia-pink-mid)' }};
    text-align: left;
    padding: 8px 14px;
  }
  #shopify-section-{{ section.id }} .rosalia-comp-table td {
    background: rgba(250, 245, 240, 0.05);
    padding: 13px 14px;
    line-height: 1.45;
    vertical-align: top;
  }
  #shopify-section-{{ section.id }} .rosalia-comp-table td:first-child {
    border-radius: 8px 0 0 8px;
    font-weight: 600;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .rosalia-comp-table td:nth-child(2) { background: rgba(227, 161, 182, 0.14); }
  #shopify-section-{{ section.id }} .rosalia-comp-table td:last-child { border-radius: 0 8px 8px 0; opacity: 0.75; }
  #shopify-section-{{ section.id }} .rosalia-comp-indicator {
    display: inline-block;
    width: 8px; height: 8px;
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: middle;
  }
  #shopify-section-{{ section.id }} .rosalia-comp-indicator--yes { background: #7BB77E; }
  #shopify-section-{{ section.id }} .rosalia-comp-indicator--no { background: #D97070; }
  #shopify-section-{{ section.id }} .rosalia-comp-indicator--mid { background: #E0B15C; }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .rosalia-comp-outer { padding: 24px 16px; }
    #shopify-section-{{ section.id }} .rosalia-comp-shell { padding: 40px 20px; }
    #shopify-section-{{ section.id }} .rosalia-comp-bottles { gap: 20px; }
    #shopify-section-{{ section.id }} .rosalia-comp-bottle-vis { width: 96px; height: 160px; }
    #shopify-section-{{ section.id }} .rosalia-comp-table td:first-child { white-space: normal; }
  }
</style>

<div {% render 'section-properties', tight: true %}>
  <div class="rosalia-comp-outer">
    <div class="rosalia-comp-shell">
      {%- if section.settings.heading != blank -%}
        <h2 class="rosalia-comp-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.lead != blank -%}
        <p class="rosalia-comp-lead">{{ section.settings.lead }}</p>
      {%- endif -%}

      <div class="rosalia-comp-bottles">
        <div class="rosalia-comp-bottle rosalia-comp-bottle--rosalia">
          <div class="rosalia-comp-bottle-vis">
            {%- if section.settings.rosalia_bottle_image != blank -%}
              {{ section.settings.rosalia_bottle_image | image_url: width: 240 | image_tag: alt: section.settings.rosalia_label }}
            {%- else -%}
              <span>{{ section.settings.rosalia_bottle_text | default: 'Rosalia' }}</span>
            {%- endif -%}
          </div>
          <div class="rosalia-comp-bottle-label">{{ section.settings.rosalia_label | default: 'Rosalia' }}</div>
        </div>

        <div class="rosalia-comp-vs">{{ section.settings.vs_label | default: 'vs' }}</div>

        <div class="rosalia-comp-bottle rosalia-comp-bottle--other">
          <div class="rosalia-comp-bottle-vis">
            {%- if section.settings.other_bottle_image != blank -%}
              {{ section.settings.other_bottle_image | image_url: width: 240 | image_tag: alt: section.settings.other_label }}
            {%- else -%}
              <span>{{ section.settings.other_bottle_text | default: 'Other serums' }}</span>
            {%- endif -%}
          </div>
          <div class="rosalia-comp-bottle-label">{{ section.settings.other_label | default: 'Other serums' }}</div>
        </div>
      </div>

      <table class="rosalia-comp-table">
        <thead>
          <tr>
            <th>{{ section.settings.col_attr_label | default: 'Attribute' }}</th>
            <th>{{ section.settings.rosalia_label | default: 'Rosalia' }}</th>
            <th>{{ section.settings.other_label | default: 'Other serums' }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'row' -%}
                <tr {{ block.shopify_attributes }}>
                  <td>
                    {%- assign ind = block.settings.indicator | default: 'yes' -%}
                    <span class="rosalia-comp-indicator rosalia-comp-indicator--{{ ind }}"></span>
                    {{ block.settings.attribute }}
                  </td>
                  <td>{{ block.settings.rosalia_value }}</td>
                  <td>{{ block.settings.other_value }}</td>
                </tr>
              {%- when 'liquid' -%}
                <tr {{ block.shopify_attributes }}><td colspan="3">{{ block.settings.custom_liquid }}</td></tr>
            {%- endcase -%}
          {%- endfor -%}
        </tbody>
      </table>

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rosalia — Comparison",
  "class": "shopify-section--rosalia",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Why nothing else <em>has worked</em>.</p>" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "One was designed for your skin. The other was designed for everyone else's." },
    { "type": "header", "content": "Bottles" },
    { "type": "text", "id": "rosalia_label", "label": "Rosalia column label", "default": "Rosalia" },
    { "type": "image_picker", "id": "rosalia_bottle_image", "label": "Rosalia bottle image" },
    { "type": "textarea", "id": "rosalia_bottle_text", "label": "Rosalia bottle text (fallback)", "default": "Rosalia\nReset Complex™\n\n5 active levers" },
    { "type": "text", "id": "vs_label", "label": "Middle label", "default": "vs" },
    { "type": "text", "id": "other_label", "label": "Other column label", "default": "Other serums" },
    { "type": "image_picker", "id": "other_bottle_image", "label": "Other bottle image" },
    { "type": "textarea", "id": "other_bottle_text", "label": "Other bottle text (fallback)", "default": "Water + 1 active + Fragrance + Fillers" },
    { "type": "header", "content": "Table" },
    { "type": "text", "id": "col_attr_label", "label": "Attribute column label", "default": "Attribute" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Shell background", "default": "#4B1528" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FAF5F0" },
    { "type": "color", "id": "accent", "label": "Accent (labels, italic)", "default": "#E3A1B6" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "attribute", "label": "Attribute", "default": "Approach" },
        { "type": "textarea", "id": "rosalia_value", "label": "Rosalia value", "default": "5 root causes addressed simultaneously" },
        { "type": "textarea", "id": "other_value", "label": "Other value", "default": "1 active ingredient, hope for the best" },
        { "type": "select", "id": "indicator", "label": "Indicator dot", "options": [{"value":"yes","label":"Positive (green)"},{"value":"no","label":"Negative (red)"},{"value":"mid","label":"Neutral (yellow)"}], "default": "yes" }
      ]
    },
    { "type": "liquid", "name": "Custom Liquid row", "settings": [ { "type": "liquid", "id": "custom_liquid", "label": "Liquid code" } ] }
  ],
  "presets": [
    { "name": "Rosalia — Comparison (versus)", "blocks": [
      { "type": "row", "settings": { "attribute": "Approach", "rosalia_value": "5 root causes addressed simultaneously", "other_value": "1 active ingredient, hope for the best" } },
      { "type": "row", "settings": { "attribute": "Irritants", "rosalia_value": "Zero essential oils. Zero fragrance. Ever.", "other_value": "Fragrance and essential oils often included" } },
      { "type": "row", "settings": { "attribute": "Niacinamide", "rosalia_value": "3–5% — the safe, effective range", "other_value": "10%+ — can trigger the sensitivity it claims to treat" } },
      { "type": "row", "settings": { "attribute": "Origin", "rosalia_value": "Built for rosacea from the first molecule", "other_value": "Made for 'normal' skin, relabeled 'sensitive'" } },
      { "type": "row", "settings": { "attribute": "Expertise", "rosalia_value": "Formulated with a vascular biologist", "other_value": "Designed by a marketing department" } },
      { "type": "row", "settings": { "attribute": "Guarantee", "rosalia_value": "60 days. Full refund. No forms.", "other_value": "7-day return window. Unopened only." } }
    ] }
  ]
}
{% endschema %}
