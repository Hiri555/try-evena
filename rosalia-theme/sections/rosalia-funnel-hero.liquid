{%- comment -%}
  Rosalia · Funnel — Editorial hero
  Eyebrow + H1 + standfirst + byline + hero image.
  One H1 per page: leave "Render as H1" ON here and OFF everywhere else.
{%- endcomment -%}

{%- render 'rosalia-funnel-assets' -%}

{%- liquid
  assign s = section.settings
  assign meta = section.blocks | where: 'type', 'meta'
-%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ s.background | default: '#FAF5F0' }};
    color: {{ s.text_color | default: '#2B2620' }};
    padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;
  }
</style>

<div class="rf">
  <div class="rf-w">

    {%- if s.eyebrow != blank -%}
      <p class="rf-eyebrow">{{ s.eyebrow }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      {%- if s.as_h1 -%}
        <h1 class="rf-h1">{{ s.heading }}</h1>
      {%- else -%}
        <p class="rf-h1">{{ s.heading }}</p>
      {%- endif -%}
    {%- endif -%}

    {%- if s.standfirst != blank -%}
      <p class="rf-standfirst">{{ s.standfirst }}</p>
    {%- endif -%}

    {%- if meta.size > 0 -%}
      <div class="rf-byline">
        {%- for block in meta -%}
          {%- unless forloop.first -%}<span class="rf-dot" aria-hidden="true">|</span>{%- endunless -%}
          <span class="{% if block.settings.strong %}rf-who{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.lead != blank -%}
      <div class="rf-prose rf-lead" style="margin-top:24px;">{{ s.lead }}</div>
    {%- endif -%}

    {%- if s.image != blank or s.placeholder_note != blank -%}
      <figure class="rf-figure">
        {%- if s.image != blank -%}
          {{ s.image
             | image_url: width: 1400
             | image_tag:
                 widths: '400, 600, 800, 1000, 1200, 1400',
                 sizes: '(min-width: 700px) 680px, 100vw',
                 loading: 'eager',
                 fetchpriority: 'high',
                 alt: s.image_alt }}
        {%- else -%}
          <div class="rf-slot" role="img" aria-label="{{ s.image_alt | default: 'Hero image placeholder' | escape }}">
            <span>{{ s.placeholder_note }}</span>
          </div>
        {%- endif -%}
        {%- if s.caption != blank -%}
          <figcaption class="rf-figcap">{{ s.caption }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Rosalia — Funnel hero",
  "class": "shopify-section--rosalia-funnel",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Headline" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Headline", "info": "Inline <em> is allowed." },
    { "type": "checkbox", "id": "as_h1", "label": "Render as H1", "default": true, "info": "Exactly one section per page should have this on." },
    { "type": "text", "id": "standfirst", "label": "Standfirst" },
    { "type": "richtext", "id": "lead", "label": "Lead paragraphs" },

    { "type": "header", "content": "Hero image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "textarea", "id": "placeholder_note", "label": "Art-direction brief", "info": "Shown in the slot until the real image is added. Taken from the visual brief." },
    { "type": "richtext", "id": "caption", "label": "Caption" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 8 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FAF5F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2B2620" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "meta", "name": "Byline item", "limit": 6,
      "settings": [
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "checkbox", "id": "strong", "label": "Emphasise", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rosalia — Funnel hero",
      "blocks": [
        { "type": "meta", "settings": { "text": "The Skin File editorial desk", "strong": true } },
        { "type": "meta", "settings": { "text": "3 min read" } }
      ]
    }
  ]
}
{% endschema %}
