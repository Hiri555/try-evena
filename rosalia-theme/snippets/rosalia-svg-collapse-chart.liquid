{%- comment -%}
  Rosalia · SVG — the endocrine collapse
  Advertorial, MARCHE 2. Recoloured from the source clay (#A9532F) onto the
  DA wine/plum. Type switched from IBM Plex Sans to Inter.
  viewBox-driven: scales to its container, no intrinsic size, so no CLS.
{%- endcomment -%}
<svg viewBox="0 0 560 250" role="img" xmlns="http://www.w3.org/2000/svg"
     aria-label="{{ label | default: 'A line showing skin held steady across nine months of pregnancy, collapsing within 24 hours of birth, then slowly recovering over the following year.' | escape }}">
  <line x1="24" y1="205" x2="540" y2="205" stroke="#E4DAD2" stroke-width="1"/>
  <line x1="300" y1="70" x2="540" y2="70" stroke="#C9BAB0" stroke-width="1" stroke-dasharray="4 4"/>
  <path d="M312 190 C 400 184, 480 176, 540 170 L 540 70 L 300 70 Z" fill="#F7E4EA" opacity="0.8"/>
  <path d="M24 198 C 120 190, 230 150, 300 72 L 312 190 C 400 184, 480 176, 540 170"
        fill="none" stroke="#7A3A54" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round"/>
  <circle cx="306" cy="72" r="3.4" fill="#4B1528"/>
  <g font-family="Inter, -apple-system, sans-serif">
    <text x="150" y="228" font-size="12.5" fill="#6E6367" text-anchor="middle">9 months of pregnancy</text>
    <text x="330" y="118" font-size="12.5" fill="#4B1528">24 hours</text>
    <text x="426" y="228" font-size="12.5" fill="#6E6367" text-anchor="middle">the year you wait</text>
    <text x="418" y="120" font-size="12" fill="#7A3A54" text-anchor="middle" font-weight="600">the gap it holds</text>
  </g>
</svg>
