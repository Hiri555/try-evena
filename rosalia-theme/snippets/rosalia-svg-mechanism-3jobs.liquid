{%- comment -%}
  Rosalia · SVG — the three jobs, propped from the outside
  Advertorial, MARCHE 5. Deliberately under-designed: the source note says
  "sous-designé = crédible". Recoloured onto the DA, type set in Inter.
{%- endcomment -%}
<svg viewBox="0 0 560 234" role="img" xmlns="http://www.w3.org/2000/svg"
     aria-label="{{ label | default: 'Diagram: the three jobs pregnancy did for your skin — calm vessels, seal the barrier, quiet the flare — and the ingredients that prop each one from the outside during recovery.' | escape }}">
  <line x1="24" y1="190" x2="536" y2="190" stroke="#E4DAD2" stroke-width="1"/>
  <line x1="24" y1="58" x2="536" y2="58" stroke="#C9BAB0" stroke-width="1" stroke-dasharray="4 4"/>
  <g font-family="Inter, -apple-system, sans-serif">
    <text x="24" y="48" font-size="11.5" fill="#7A6E72">what pregnancy held up, all day, for nine months</text>

    <rect x="76" y="58" width="90" height="132" rx="3" fill="#F7E4EA" stroke="#7A3A54" stroke-width="1.3"/>
    <text x="121" y="118" text-anchor="middle" font-size="11.5" fill="#4B1528">licochalcone A</text>
    <text x="121" y="212" text-anchor="middle" font-size="13" fill="#1F1A1C" font-weight="600">Calm vessels</text>

    <rect x="235" y="58" width="90" height="132" rx="3" fill="#F7E4EA" stroke="#7A3A54" stroke-width="1.3"/>
    <text x="280" y="106" text-anchor="middle" font-size="11.5" fill="#4B1528">colloidal oat</text>
    <text x="280" y="124" text-anchor="middle" font-size="11.5" fill="#4B1528">panthenol</text>
    <text x="280" y="212" text-anchor="middle" font-size="13" fill="#1F1A1C" font-weight="600">Seal the barrier</text>

    <rect x="394" y="58" width="90" height="132" rx="3" fill="#F7E4EA" stroke="#7A3A54" stroke-width="1.3"/>
    <text x="439" y="106" text-anchor="middle" font-size="11.5" fill="#4B1528">azelaic</text>
    <text x="439" y="124" text-anchor="middle" font-size="11.5" fill="#4B1528">centella</text>
    <text x="439" y="212" text-anchor="middle" font-size="13" fill="#1F1A1C" font-weight="600">Quiet the flare</text>
  </g>
</svg>
