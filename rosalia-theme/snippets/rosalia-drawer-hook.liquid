{%- comment -%}
  Rosalia · Cart drawer opener

  This snippet used to do three things. Two of them were wrong and are
  gone. What is left is the one that was safe.

  WHAT WAS REMOVED, AND WHY IT MATTERED

  1. A submit hijack on the product form. It called preventDefault()
     and posted the cart itself with fetch(). Two consequences:

     a) Kaching Bundles never ran its own add-to-cart path, which is
        what fires its conversion tracking. Its script still loaded and
        counted page views, so the dashboard showed visitors with 0%
        conversion and $0 revenue while orders were coming in. Proof:
        every line item on every order since the deal was created had
        an empty customAttributes — not one Kaching property, ever.

     b) The preventDefault() was inside a setTimeout(..., 0), which
        runs AFTER the event has finished dispatching. Calling it there
        does nothing at all. So the browser performed the native form
        submit as well — a full-page POST to /cart — while the fetch()
        fired in parallel. That is almost certainly the "customers
        click and nothing happens" behaviour: a full page navigation
        instead of a drawer, and a race between two competing adds.

  2. A DOM scraper that tried to read Kaching's selected deal out of the
     page and copy it into our own form. Its last fallback selector was
     `input[type="radio"][name="id"]:checked`, which matched the
     hand-built bundle_tiers radio sitting right next to the Kaching
     widget — so it could overwrite the offer the customer had actually
     chosen. That radio block has been removed from the product
     template too; the offer ladder belongs to Kaching alone.

  WHAT IS LEFT

  A passive observer on fetch and XHR. It does not intercept, redirect,
  cancel or modify anything — it wraps the call, returns the original
  promise untouched, and only watches whether a POST to /cart/add came
  back 2xx so it can open the cart drawer afterwards. Whoever performed
  the add — Kaching, the theme's own product-form element, an upsell
  app — the drawer opens and nothing about their request changes.

  If the drawer ever needs to go away too, deleting this whole snippet
  is safe: add-to-cart does not depend on it.
{%- endcomment -%}

<script>
  (function () {
    if (window.__rosaliaDrawerHook) return;
    window.__rosaliaDrawerHook = true;

    function openDrawer() {
      var drawer = document.querySelector('cart-drawer, cart-notification-drawer, [id="cart-drawer"], .cart-drawer, .drawer--cart');
      if (drawer) {
        if (typeof drawer.open === 'function') { try { drawer.open(); return true; } catch (e) {} }
        drawer.setAttribute('open', '');
        drawer.classList.add('is-open', 'active', 'drawer--visible');
      }
      var trigger = document.querySelector('[href="#cart-drawer"], [data-cart-drawer-trigger], a[href$="/cart"][data-drawer-trigger], .cart-drawer-trigger');
      if (trigger) { trigger.click(); return true; }
      return !!drawer;
    }

    function afterAdd() {
      document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true }));
      document.dispatchEvent(new CustomEvent('cart:build', { bubbles: true }));
      openDrawer();
    }

    /* Passive observers. Pass-through only — the original promise and
       the original response are returned untouched. */
    var origFetch = window.fetch;
    if (typeof origFetch === 'function') {
      window.fetch = function (input, init) {
        var url = typeof input === 'string' ? input : (input && input.url) || '';
        var method = (init && init.method) || (input && input.method) || 'GET';
        var isAdd = /\/cart\/add(\.js)?(\?|$)/.test(url) && String(method).toUpperCase() === 'POST';
        var p = origFetch.apply(this, arguments);
        if (isAdd && p && typeof p.then === 'function') {
          p.then(function (res) { if (res && res.ok) setTimeout(afterAdd, 60); })
           .catch(function () {});
        }
        return p;
      };
    }

    var origOpen = XMLHttpRequest.prototype.open;
    var origSend = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.open = function (method, url) {
      this.__rosMethod = method; this.__rosUrl = url || '';
      return origOpen.apply(this, arguments);
    };
    XMLHttpRequest.prototype.send = function () {
      var xhr = this;
      var isAdd = /\/cart\/add(\.js)?(\?|$)/.test(xhr.__rosUrl || '')
               && String(xhr.__rosMethod || '').toUpperCase() === 'POST';
      if (isAdd) {
        xhr.addEventListener('load', function () {
          if (xhr.status >= 200 && xhr.status < 300) setTimeout(afterAdd, 60);
        });
      }
      return origSend.apply(this, arguments);
    };
  })();
</script>
