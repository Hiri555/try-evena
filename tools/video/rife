#!/opt/vfx/esrgan/bin/python
"""RIFE HDv3 frame interpolation (CPU), without the repo's dead sk-video/moviepy deps.

  rife -i in.mp4 -o out.mp4              # 2x the frame rate
  rife -i in.mp4 -o out.mp4 --exp 2      # 4x
  rife -i in.mp4 -o out.mp4 --fps 60     # target an exact output fps
  rife -a a.png -b b.png -o mid.png      # a single in-between frame
"""
import argparse, os, shutil, subprocess, sys, tempfile, time
import numpy as np
import torch
from torch.nn import functional as F

RIFE_ROOT = '/opt/vfx/rife'
sys.path.insert(0, RIFE_ROOT)


def load(threads):
    torch.set_num_threads(threads)
    torch.set_grad_enabled(False)
    from train_log.RIFE_HDv3 import Model            # noqa: E402
    m = Model()
    m.load_model(os.path.join(RIFE_ROOT, 'train_log'), -1)
    m.eval()
    m.device()
    return m


def pad(t, scale):
    _, _, h, w = t.shape
    d = max(int(32 / scale), 32)
    ph = ((h - 1) // d + 1) * d
    pw = ((w - 1) // d + 1) * d
    return F.pad(t, (0, pw - w, 0, ph - h)), h, w


def to_t(arr):
    return torch.from_numpy(arr.transpose(2, 0, 1)).float().unsqueeze(0) / 255.


def to_a(t, h, w):
    return (t[0, :, :h, :w].clamp(0, 1).permute(1, 2, 0).numpy() * 255).round().astype(np.uint8)


def between(model, a, b, n, scale):
    """n intermediate frames between a and b, recursively (n = 2^k - 1)."""
    if n == 1:
        return [model.inference(a, b, scale)]
    mid = model.inference(a, b, scale)
    k = n // 2
    return between(model, a, mid, k, scale) + [mid] + between(model, mid, b, k, scale)


def main():
    p = argparse.ArgumentParser(description='RIFE HDv3 — interpolation d\'images (CPU)')
    p.add_argument('-i', '--input')
    p.add_argument('-a'); p.add_argument('-b')
    p.add_argument('-o', '--output', required=True)
    p.add_argument('--exp', type=int, default=1, help='1 = x2, 2 = x4, 3 = x8')
    p.add_argument('--fps', type=float, default=None, help='fps de sortie exact (prioritaire sur --exp)')
    p.add_argument('--scale', type=float, default=1.0, choices=[0.25, 0.5, 1.0, 2.0, 4.0],
                   help='0.5 pour la 4K, 1.0 pour la HD')
    p.add_argument('--threads', type=int, default=os.cpu_count() or 4)
    p.add_argument('--crf', type=int, default=17)
    p.add_argument('--preset', default='medium')
    a = p.parse_args()

    model = load(a.threads)
    print(f"· RIFE HDv3 · {a.threads} threads · scale {a.scale}")

    # --- two stills -> one in-between
    if a.a and a.b:
        import cv2
        i0, i1 = cv2.imread(a.a), cv2.imread(a.b)
        t0, h, w = pad(to_t(i0), a.scale)
        t1, _, _ = pad(to_t(i1), a.scale)
        mid = model.inference(t0, t1, a.scale)
        cv2.imwrite(a.output, to_a(mid, h, w))
        print(f"✓ {a.output}")
        return

    if not a.input:
        sys.exit("✗ donne -i video.mp4, ou -a img1 -b img2")

    pr = subprocess.run(['ffprobe', '-v', 'error', '-select_streams', 'v:0',
                         '-show_entries', 'stream=width,height,r_frame_rate',
                         '-of', 'default=nw=1:nk=1', a.input],
                        capture_output=True, text=True).stdout.split()
    w, h = int(pr[0]), int(pr[1])
    num, den = (pr[2].split('/') + ['1'])[:2]
    src_fps = float(num) / float(den)
    mult = 2 ** a.exp
    out_fps = a.fps if a.fps else src_fps * mult
    if a.fps:
        mult = max(2, int(round(a.fps / src_fps)))
        mult = 2 ** max(1, round(np.log2(mult)))
    n_mid = mult - 1
    print(f"· {w}x{h} {src_fps:.3f} fps → {out_fps:.3f} fps (x{mult})")

    tmp = tempfile.mkdtemp(prefix='rife_')
    fin, fout = os.path.join(tmp, 'in'), os.path.join(tmp, 'out')
    os.makedirs(fin); os.makedirs(fout)
    try:
        subprocess.run(['ffmpeg', '-v', 'error', '-i', a.input, '-qscale:v', '1',
                        os.path.join(fin, '%06d.jpg')], check=True)
        import cv2
        names = sorted(os.listdir(fin))
        n = len(names)
        idx = 0
        t0 = time.time()
        prev = None
        for i, nm in enumerate(names):
            cur_a = cv2.imread(os.path.join(fin, nm))
            cur, hh, ww = pad(to_t(cur_a), a.scale)
            if prev is not None:
                for mt in between(model, prev, cur, n_mid, a.scale):
                    idx += 1
                    cv2.imwrite(os.path.join(fout, f"{idx:07d}.jpg"), to_a(mt, hh, ww),
                                [cv2.IMWRITE_JPEG_QUALITY, 96])
            idx += 1
            cv2.imwrite(os.path.join(fout, f"{idx:07d}.jpg"), cur_a,
                        [cv2.IMWRITE_JPEG_QUALITY, 96])
            prev = cur
            if i % 2 == 0 or i == n - 1:
                el = time.time() - t0
                print(f"\r· {i+1}/{n} images sources  {el/max(i+1,1):.1f}s/image  "
                      f"reste {(n-i-1)*el/max(i+1,1)/60:.1f} min   ", end='', flush=True)
        print()
        has_audio = subprocess.run(['ffprobe', '-v', 'error', '-select_streams', 'a:0',
                                    '-show_entries', 'stream=codec_type', '-of', 'csv=p=0', a.input],
                                   capture_output=True, text=True).stdout.strip() != ''
        cmd = ['ffmpeg', '-y', '-v', 'error', '-stats', '-framerate', str(out_fps),
               '-i', os.path.join(fout, '%07d.jpg')]
        if has_audio:
            cmd += ['-i', a.input, '-map', '0:v', '-map', '1:a', '-c:a', 'copy']
        cmd += ['-c:v', 'libx264', '-crf', str(a.crf), '-preset', a.preset,
                '-pix_fmt', 'yuv420p', '-movflags', '+faststart', a.output]
        subprocess.run(cmd, check=True)
        print(f"✓ {a.output}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == '__main__':
    main()
