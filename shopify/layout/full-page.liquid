<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#FAF5F0">
    <title>{{ page_title }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    {{ 'advertorial.css' | asset_url | stylesheet_tag }}

    {%- comment -%} REQUIRED · this is how silent apps (Meta Pixel, GA4, TikTok Pixel, analytics, subscription SDKs) inject their scripts {%- endcomment -%}
    {{ content_for_header }}
  </head>
  <body class="advertorial-body advertorial-app-gated">
    {{ content_for_layout }}
    {{ 'advertorial.js' | asset_url | script_tag }}
  </body>
</html>
