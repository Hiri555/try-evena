        "liquid": "<style>\n  .aureva-trust-logos {\n    --verde: #0F6E56;\n    --verde-dark: #14332A;\n    --verde-soft: #9FE1CB;\n    --verde-tile: #EAF4EE;\n    --creme: #F4EFE4;\n    --paper: #FBFAF6;\n    --muted: #4C6A5D;\n    --border: #E9E2D4;\n\n    width: 100%;\n    overflow: hidden;\n    background: transparent;\n    padding: 18px 0;\n    position: relative;\n  }\n\n  .aureva-trust-logos__track {\n    display: flex;\n    width: max-content;\n    align-items: center;\n    animation: aureva-logo-scroll 28s linear infinite;\n  }\n\n  .aureva-trust-logos__group {\n    display: flex;\n    align-items: center;\n    flex-shrink: 0;\n  }\n\n  .aureva-trust-logos__item {\n    width: 150px;\n    height: 58px;\n    margin: 0 22px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n\n  .aureva-trust-logos__item img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    display: block;\n\n    /* Rend le bandeau plus élégant et homogène */\n    opacity: 0.82;\n    filter: grayscale(100%);\n    transition: opacity .25s ease, filter .25s ease;\n  }\n\n  .aureva-trust-logos__item:hover img {\n    opacity: 1;\n    filter: grayscale(0%);\n  }\n\n  @keyframes aureva-logo-scroll {\n    from {\n      transform: translateX(0);\n    }\n    to {\n      transform: translateX(-50%);\n    }\n  }\n\n  /* Mobile */\n  @media screen and (max-width: 749px) {\n    .aureva-trust-logos {\n      padding: 14px 0;\n    }\n\n    .aureva-trust-logos__item {\n      width: 115px;\n      height: 45px;\n      margin: 0 15px;\n    }\n\n    .aureva-trust-logos__track {\n      animation-duration: 22s;\n    }\n  }\n\n  /* Respecte les préférences d'accessibilité */\n  @media (prefers-reduced-motion: reduce) {\n    .aureva-trust-logos__track {\n      animation: none;\n    }\n  }\n</style>\n\n<div class=\"aureva-trust-logos\">\n  <div class=\"aureva-trust-logos__track\">\n\n    <!-- Groupe 1 -->\n    <div class=\"aureva-trust-logos__group\">\n\n      <div class=\"aureva-trust-logos__item\">\n        <img\n          src=\"//fittabella.com/cdn/shop/files/Press_1_300x300_d8793cbd-82d5-4008-ab97-3e24b82ab511_small.avif?v=1754051195\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n      </div>\n\n      <div class=\"aureva-trust-logos__item\">\n        <img\n          src=\"//fittabella.com/cdn/shop/files/Press_4_300x300_461db9ef-65c0-4886-81d4-6d8e6b24d8b8_small.avif?v=1754051194\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n      </div>\n\n      <div class=\"aureva-trust-logos__item\">\n        <img\n          src=\"//fittabella.com/cdn/shop/files/Press_3_300x300_6be66818-ade7-4936-992e-9842ccf917b7_small.avif?v=1754051195\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n      </div>\n\n      <div class=\"aureva-trust-logos__item\">\n        <img\n          src=\"//fittabella.com/cdn/shop/files/Press_2_300x300_0a14907a-433a-4557-8c2f-2881f50c07cc_small.avif?v=1754051195\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n      </div>\n\n      <div class=\"aureva-trust-logos__item\">\n        <img\n          src=\"//fittabella.com/cdn/shop/files/Press_5_300x300_dc3410c7-27e4-457a-9d85-f7535a389a19_small.avif?v=1754051194\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n      </div>\n\n      <div class=\"aureva-trust-logos__item\">\n        <img\n          src=\"//fittabella.com/cdn/shop/files/Press_6_300x300_e68a66b6-a00d-4712-b2ac-8093f0d16750_small.avif?v=1754051194\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n      </div>\n\n      <div class=\"aureva-trust-logos__item\">\n        <img\n          src=\"//fittabella.com/cdn/shop/files/PikPng.com_xxl-magazine-logo-png_4513115_300x300.png?v=1756123879\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n      </div>\n\n    </div>\n\n    <!-- Groupe 2 : duplication pour boucle continue -->\n    <div class=\"aureva-trust-logos__group\" aria-hidden=\"true\">\n\n      <div class=\"aureva-trust-logos__item\">\n        <img src=\"//fittabella.com/cdn/shop/files/Press_1_300x300_d8793cbd-82d5-4008-ab97-3e24b82ab511_small.avif?v=1754051195\" alt=\"\">\n      </div>\n\n      <div class=\"aureva-trust-logos__item\">\n        <img src=\"//fittabella.com/cdn/shop/files/Press_4_300x300_461db9ef-65c0-4886-81d4-6d8e6b24d8b8_small.avif?v=1754051194\" alt=\"\">\n      </div>\n\n      <div class=\"aureva-trust-logos__item\">\n        <img src=\"//fittabella.com/cdn/shop/files/Press_3_300x300_6be66818-ade7-4936-992e-9842ccf917b7_small.avif?v=1754051195\" alt=\"\">\n      </div>\n\n      <div class=\"aureva-trust-logos__item\">\n        <img src=\"//fittabella.com/cdn/shop/files/Press_2_300x300_0a14907a-433a-4557-8c2f-2881f50c07cc_small.avif?v=1754051195\" alt=\"\">\n      </div>\n\n      <div class=\"aureva-trust-logos__item\">\n        <img src=\"//fittabella.com/cdn/shop/files/Press_5_300x300_dc3410c7-27e4-457a-9d85-f7535a389a19_small.avif?v=1754051194\" alt=\"\">\n      </div>\n\n      <div class=\"aureva-trust-logos__item\">\n        <img src=\"//fittabella.com/cdn/shop/files/Press_6_300x300_e68a66b6-a00d-4712-b2ac-8093f0d16750_small.avif?v=1754051194\" alt=\"\">\n      </div>\n\n      <div class=\"aureva-trust-logos__item\">\n        <img src=\"//fittabella.com/cdn/shop/files/PikPng.com_xxl-magazine-logo-png_4513115_300x300.png?v=1756123879\" alt=\"\">\n      </div>\n\n    </div>\n\n  </div>\n</div>",
